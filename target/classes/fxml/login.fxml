<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eventmanagement.controllers.LoginController"
            stylesheets="@../css/style.css" prefWidth="500" prefHeight="600">
    
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 40;">
            <Label text="Gestion des Événements" styleClass="title-label">
                <font>
                    <Font name="System Bold" size="28"/>
                </font>
            </Label>
            
            <Label text="Connexion" styleClass="subtitle-label">
                <font>
                    <Font size="20"/>
                </font>
            </Label>
            
            <VBox spacing="10" style="-fx-max-width: 350;">
                <Label text="Email:" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="Entrez votre email" styleClass="custom-field"/>
                
                <Label text="Mot de passe:" styleClass="field-label"/>
                <HBox spacing="5">
                    <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe" 
                                   styleClass="custom-field" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="passwordVisibleField" promptText="Entrez votre mot de passe" 
                               styleClass="custom-field" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="togglePasswordBtn" text="👁" onAction="#togglePasswordVisibility" 
                            styleClass="icon-button" prefWidth="40"/>
                </HBox>
                
                <Label fx:id="errorLabel" styleClass="error-label" visible="false"/>
                
                <Button text="Se connecter" onAction="#handleLogin" styleClass="primary-button" 
                        prefWidth="350" prefHeight="40">
                    <font>
                        <Font size="14"/>
                    </font>
                </Button>
                
                <HBox alignment="CENTER" spacing="5">
                    <Label text="Pas encore de compte ?"/>
                    <Hyperlink text="S'inscrire" onAction="#handleRegister" styleClass="link"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
