<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900" prefWidth="1600" style="-fx-background-color: #f5f5dc;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.HistoriqueCommandesController">

    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #5a8c4a, #4a7c3a);">
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20 30; -fx-background-color: #f0f4f0;">
                <Region prefWidth="20" />
                <VBox spacing="2">
                    <Label style="-fx-text-fill: whblackite; -fx-font-size: 26px; -fx-font-weight: bold;" text="AgriConnect - Historique des Commandes" />
                    <Label style="-fx-text-fill: black; -fx-font-size: 13px;" text="Les 20 dernières commandes groupées par statut" />
                </VBox>
                <Region style="-fx-background-color: #f0f4f0;" HBox.hgrow="ALWAYS" />
                <HBox spacing="8">
                    <VBox alignment="CENTER" prefWidth="85" style="-fx-background-color: #388e3c; -fx-background-radius: 10; -fx-padding: 6 10;">
                        <Label style="-fx-text-fill: #e8f5e9; -fx-font-size: 9px;" text="TOTAL" />
                        <Label fx:id="lblTotal" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="85" style="-fx-background-color: #388e3c; -fx-background-radius: 10; -fx-padding: 6 10;">
                        <Label style="-fx-text-fill: #e8f5e9; -fx-font-size: 9px;" text="EN COURS" />
                        <Label fx:id="lblEnCours" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="85" style="-fx-background-color: #388e3c; -fx-background-radius: 10; -fx-padding: 6 10;">
                        <Label style="-fx-text-fill: #e8f5e9; -fx-font-size: 9px;" text="LIVRÉES" />
                        <Label fx:id="lblLivrees" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
                    </VBox>
                </HBox>
                <Label fx:id="lblStatus" style="-fx-text-fill: white; -fx-font-size: 13px;                               -fx-background-color: rgba(0,0,0,0.2); -fx-padding: 8 15; -fx-background-radius: 15;" text="Prêt" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30 50; -fx-background-color: #f0f4f0;">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4a7c3a;" text="🗂️ Commandes groupées par statut" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#actualiser" prefHeight="36" prefWidth="140" style="-fx-background-color: #5bc0de; -fx-text-fill: white; -fx-font-weight: bold;                                -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;" text="🔄 Actualiser" />
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                <VBox spacing="5" style="-fx-background-color: transparent;">

                    <Accordion fx:id="accordion">
                        <panes>
                            <TitledPane fx:id="paneEnCours" text="⏳  EN COURS  —">
                                <VBox fx:id="listEnCours" spacing="8" style="-fx-padding: 10;" />
                            </TitledPane>

                            <TitledPane fx:id="paneValidee" text="✅  VALIDÉE  —">
                                <VBox fx:id="listValidee" spacing="8" style="-fx-padding: 10;" />
                            </TitledPane>

                            <TitledPane fx:id="paneExpediee" text="🚚  EXPÉDIÉE  —">
                                <VBox fx:id="listExpediee" spacing="8" style="-fx-padding: 10;" />
                            </TitledPane>

                            <TitledPane fx:id="paneLivree" text="📦  LIVRÉE  —">
                                <VBox fx:id="listLivree" spacing="8" style="-fx-padding: 10;" />
                            </TitledPane>

                            <TitledPane fx:id="paneAnnulee" text="❌  ANNULÉE  —">
                                <VBox fx:id="listAnnulee" spacing="8" style="-fx-padding: 10;" />
                            </TitledPane>
                        </panes>
                    </Accordion>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
