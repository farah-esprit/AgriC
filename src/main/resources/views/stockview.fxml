<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.StockController"
            prefWidth="1250" prefHeight="800"
            stylesheets="@../css/style.css">

    <top>
        <VBox styleClass="header">
            <HBox alignment="CENTER" spacing="10">
                <Label text="🌱 Gestion du Stock Agricole" styleClass="header-title"/>
            </HBox>
            <Label text="Suivez et gérez vos stocks en temps réel" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.32" styleClass="main-split">

            <!-- FORMULAIRE (GAUCHE) -->
            <VBox styleClass="form-section" alignment="CENTER" VBox.vgrow="ALWAYS">
                <Label text="📦 Gérer le Stock" styleClass="section-title-large"/>

                <VBox spacing="30" styleClass="form-container" VBox.vgrow="NEVER">
                    <padding>
                        <Insets top="20" right="30" bottom="20" left="30"/>
                    </padding>

                    <GridPane hgap="24" vgap="24" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="160" prefWidth="170" hgrow="NEVER"/>
                            <ColumnConstraints hgrow="SOMETIMES" prefWidth="300"/>
                        </columnConstraints>
                        <padding>
                            <Insets top="15" bottom="15"/>
                        </padding>

                        <Label text="Produit :" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-field"/>
                        <ComboBox fx:id="cbProduit" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="340" prefHeight="50"
                                  promptText="🔍 Sélectionnez un produit..." styleClass="input-field input-large"/>

                        <Label text="Quantité disponible :" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-field"/>
                        <TextField fx:id="tfQuantite" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="240" prefHeight="50"
                                   promptText="Ex: 150" styleClass="input-field input-large"/>

                        <Label text="Seuil alerte :" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-field"/>
                        <TextField fx:id="tfSeuilAlerte" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="240" prefHeight="50"
                                   promptText="Ex: 25" styleClass="input-field input-large"/>
                    </GridPane>

                    <!-- Barre boutons avec icônes + EXPORT CSV -->
                    <HBox spacing="18" alignment="CENTER" styleClass="button-bar">
                        <Button fx:id="btnAjouter" text="➕ Ajouter" onAction="#handleAjouter" styleClass="button button-success"/>
                        <Button fx:id="btnModifier" text="✏️ Modifier" onAction="#handleModifier" styleClass="button button-warning"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnSupprimer" text="🗑️ Supprimer" onAction="#handleSupprimer" styleClass="button button-danger"/>
                        <Button fx:id="btnActualiser" text="🔄 Actualiser" onAction="#handleActualiser" styleClass="button button-info"/>
                        <!-- NOUVEAU BOUTON EXPORT CSV -->
                        <Button text="Exporter CSV" onAction="#exporterCSV" styleClass="button button-info"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- TABLEAU (DROITE) -->
            <VBox styleClass="table-section" spacing="20" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="📊 Liste des Stocks" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="table-scroll">
                    <TableView fx:id="tableStock" styleClass="table-view-modern">
                        <columns>
                            <TableColumn fx:id="colIdStock" text="ID" prefWidth="85" minWidth="75"/>
                            <TableColumn fx:id="colIdProduit" text="ID Produit" prefWidth="105" minWidth="95"/>
                            <TableColumn fx:id="colProduit" text="Nom du Produit" prefWidth="320" minWidth="250"/>
                            <TableColumn fx:id="colQuantite" text="Quantité" prefWidth="160" minWidth="130"/>
                            <TableColumn fx:id="colSeuilAlerte" text="Seuil Alerte" prefWidth="160" minWidth="130"/>
                        </columns>
                    </TableView>
                </ScrollPane>
            </VBox>

        </SplitPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="status-bar">
            <Label styleClass="status-icon">✅</Label>
            <Label fx:id="lblStatus" text="Prêt - Cliquez sur Actualiser pour charger les données." styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Agriculture Pro © 2026" styleClass="status-footer"/>
        </HBox>
    </bottom>
</BorderPane>