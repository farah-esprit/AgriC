<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ProduitController"
            prefWidth="1250" prefHeight="800"
            stylesheets="@../css/style.css">

    <!-- HEADER -->
    <top>
        <VBox styleClass="header">
            <HBox alignment="CENTER" spacing="10">
                <Label text="📦 Gestion des Produits" styleClass="header-title"/>
            </HBox>
            <Label text="Ajoutez, modifiez ou supprimez vos produits" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <SplitPane dividerPositions="0.35" styleClass="main-split">

            <!-- LEFT - FORM -->
            <VBox styleClass="form-section" alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS">
                <Label text="Formulaire Produit" styleClass="section-title-large"/>

                <VBox spacing="25" styleClass="form-container">
                    <padding>
                        <Insets top="20" right="30" bottom="20" left="30"/>
                    </padding>

                    <GridPane hgap="24" vgap="24" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="160" prefWidth="170" hgrow="NEVER"/>
                            <ColumnConstraints hgrow="SOMETIMES" prefWidth="300"/>
                        </columnConstraints>

                        <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-field"/>
                        <TextField fx:id="tfNom" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="340" prefHeight="50" promptText="Ex: Huile d'olive extra vierge" styleClass="input-field input-large"/>

                        <Label text="Description :" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-field"/>
                        <TextField fx:id="tfDescription" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="340" prefHeight="50" promptText="Description du produit..." styleClass="input-field input-large"/>

                        <Label text="Prix (DT) :" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-field"/>
                        <TextField fx:id="tfPrix" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="240" prefHeight="50" promptText="Ex: 28.50" styleClass="input-field input-large"/>

                        <Label text="Catégorie :" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="label-field"/>
                        <ComboBox fx:id="cbCategorie" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="340" prefHeight="50"
                                  promptText="Sélectionnez une catégorie..." styleClass="input-field input-large"/>
                    </GridPane>

                    <HBox spacing="18" alignment="CENTER" styleClass="button-bar">
                        <Button fx:id="btnAjouter" text="➕ Ajouter" onAction="#handleAjouter" styleClass="button button-success"/>
                        <Button fx:id="btnModifier" text="✏️ Modifier" onAction="#handleModifier" styleClass="button button-warning"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnSupprimer" text="🗑️ Supprimer" onAction="#handleSupprimer" styleClass="button button-danger"/>
                        <Button fx:id="btnActualiser" text="🔄 Actualiser" onAction="#handleActualiser" styleClass="button button-info"/>
                        <!-- NOUVEAU BOUTON EXPORT CSV -->
                        <Button text="Exporter CSV" onAction="#exporterCSV" styleClass="button button-info"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- RIGHT - TABLE -->
            <VBox styleClass="table-section" spacing="20" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="📊 Liste des Produits" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="table-scroll">
                    <TableView fx:id="tableProduit" styleClass="table-view-modern">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="85" minWidth="75"/>
                            <TableColumn fx:id="colNom" text="Nom" prefWidth="320" minWidth="250"/>
                            <TableColumn fx:id="colDescription" text="Description" prefWidth="340" minWidth="280"/>
                            <TableColumn fx:id="colPrix" text="Prix (DT)" prefWidth="160" minWidth="130"/>
                            <TableColumn fx:id="colCategorie" text="Catégorie" prefWidth="180" minWidth="140"/>
                        </columns>
                    </TableView>
                </ScrollPane>
            </VBox>

        </SplitPane>
    </center>

    <!-- STATUS BAR -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="status-bar">
            <Label styleClass="status-icon">✅</Label>
            <Label fx:id="lblStatus" text="Prêt - Cliquez sur Actualiser pour charger les données." styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Agriculture Pro © 2026" styleClass="status-footer"/>
        </HBox>
    </bottom>

</BorderPane>