<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.HomeController"
            prefWidth="1400" prefHeight="850"
            style="-fx-background-color: #f5f5dc;">

    <!-- LEFT SIDEBAR VERTE -->
    <left>
        <VBox prefWidth="240"
              style="-fx-background-color: linear-gradient(to bottom, #4a7c3a, #3d6630);">

            <!-- Logo AgriConnect -->
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-padding: 30 15 25 15; -fx-background-color: rgba(0,0,0,0.15);">
                <Label text="🌾" style="-fx-font-size: 40px;"/>
                <Label text="AgriConnect"
                       style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                <Label text="Fournisseur"
                       style="-fx-text-fill: #c8e6c9; -fx-font-size: 14px;"/>
            </VBox>

            <Region VBox.vgrow="SOMETIMES" prefHeight="30"/>

            <!-- Menu Navigation -->
            <VBox spacing="8" style="-fx-padding: 15 12;">

                <Button text="🏠  Accueil"
                        prefWidth="216" prefHeight="50"
                        style="-fx-background-color: rgba(255,255,255,0.25); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-alignment: center-left; -fx-padding: 12 20; -fx-cursor: hand; -fx-background-radius: 8;"/>

                <Button text="📦  Mes produits"
                        onAction="#goToProduits"
                        prefWidth="216" prefHeight="50"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px; -fx-alignment: center-left; -fx-padding: 12 20; -fx-cursor: hand; -fx-background-radius: 8;"
                        onMouseEntered="#onMouseEntered"
                        onMouseExited="#onMouseExited"/>

                <Button text="🛒  Commandes"
                        onAction="#goToCommandes"
                        prefWidth="216" prefHeight="50"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px; -fx-alignment: center-left; -fx-padding: 12 20; -fx-cursor: hand; -fx-background-radius: 8;"
                        onMouseEntered="#onMouseEntered"
                        onMouseExited="#onMouseExited"/>

                <Button text="📊  Gestion stock"
                        onAction="#goToStock"
                        prefWidth="216" prefHeight="50"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px; -fx-alignment: center-left; -fx-padding: 12 20; -fx-cursor: hand; -fx-background-radius: 8;"
                        onMouseEntered="#onMouseEntered"
                        onMouseExited="#onMouseExited"/>

                <Button text="📜  Historique"
                        onAction="#voirHistorique"
                        prefWidth="216" prefHeight="50"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px; -fx-alignment: center-left; -fx-padding: 12 20; -fx-cursor: hand; -fx-background-radius: 8;"
                        onMouseEntered="#onMouseEntered"
                        onMouseExited="#onMouseExited"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Déconnexion -->
            <VBox style="-fx-padding: 15 12 25 12;">
                <Button text="➡️  Déconnexion"
                        prefWidth="216" prefHeight="45"
                        style="-fx-background-color: rgba(255,100,100,0.2); -fx-text-fill: #ffcccc; -fx-font-size: 14px; -fx-alignment: center-left; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;"
                        onMouseEntered="#onMouseEntered"
                        onMouseExited="#onMouseExited"/>
            </VBox>
        </VBox>
    </left>

    <!-- ZONE PRINCIPALE (DROITE) -->
    <center>
        <VBox style="-fx-background-color: #f5f5dc;">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: linear-gradient(to right, #5a8c4a, #4a7c3a); -fx-padding: 25 35;">
                <Label text="interface Fournisseur"
                       style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
            </HBox>

            <!-- CONTENU CENTRAL -->
            <VBox alignment="CENTER" spacing="40" VBox.vgrow="ALWAYS" style="-fx-padding: 50 40;">

                <!-- Logo et message de bienvenue -->
                <VBox alignment="CENTER" spacing="20">
                    <StackPane style="-fx-background-color: white; -fx-background-radius: 120; -fx-pref-width: 240; -fx-pref-height: 240; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5);">
                        <ImageView fitWidth="200" fitHeight="200" preserveRatio="true">
                            <image>
                                <Image url="@../images/logo.png" />
                            </image>
                        </ImageView>
                    </StackPane>

                    <Label text="Bienvenue, Fournisseur !"
                           style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>

                    <Label text="Votre catalogue et vos commandes"
                           style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
                </VBox>

                <!-- Bouton Mon Profil -->
                <Button text="👤 Mon Profil"
                        prefWidth="280" prefHeight="55"
                        style="-fx-background-color: linear-gradient(to right, #66bb6a, #4caf50); -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 30; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 12, 0, 0, 4);"/>

                <!-- Fonctionnalités à venir -->
                <VBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: white; -fx-padding: 30 40; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3); -fx-pref-width: 550;">

                    <Label text="✨ Fonctionnalités à venir :"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4a7c3a;"/>

                    <VBox spacing="10" style="-fx-padding: 10 20;">
                        <Label text="• Gestion du catalogue de produits (CRUD)"
                               style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
                        <Label text="• Suivi des commandes des agriculteurs"
                               style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
                        <Label text="• Gestion du stock"
                               style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
                        <Label text="• Statistiques de ventes"
                               style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
                    </VBox>
                </VBox>

            </VBox>

            <!-- FOOTER -->
            <HBox alignment="CENTER" spacing="15"
                  style="-fx-background-color: #4a7c3a; -fx-padding: 15 25;">
                <Label text="© AgriConnect 2025 – Tous droits réservés"
                       style="-fx-text-fill: white; -fx-font-size: 13px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="✅ Système opérationnel"
                       style="-fx-text-fill: #c8e6c9; -fx-font-size: 12px;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>