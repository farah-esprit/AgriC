<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.HomeController"
            prefWidth="1280" prefHeight="720"
            styleClass="home-root"
            stylesheets="@../css/style.css">

    <top>
        <VBox alignment="CENTER" spacing="25" style="-fx-padding: 60 0 40 0;">
            <!-- Logo -->
            <ImageView fitWidth="240" fitHeight="240" preserveRatio="true">
                <image>
                    <Image url="@../images/logo.png" />
                </image>
            </ImageView>

            <Label text="AGRI CONNECT" styleClass="title-main"/>
            <Label text="Gestion complète de votre exploitation agricole" styleClass="subtitle-main"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="60">
            <!-- Main cards -->
            <HBox alignment="CENTER" spacing="70">
                <!-- Produits -->
                <VBox styleClass="card">
                    <ImageView fitWidth="90" fitHeight="90" style="-fx-padding: 20;">
                        <image>
                            <Image url="@../images/icons/products.png" />
                        </image>
                    </ImageView>
                    <Label text="Produits" styleClass="card-title"/>
                    <Label text="Gérez votre catalogue complet" styleClass="card-subtitle"/>
                    <Button text="Accéder" onAction="#goToProduits" styleClass="card-button"/>
                </VBox>

                <!-- Stock -->
                <VBox styleClass="card">
                    <ImageView fitWidth="90" fitHeight="90" style="-fx-padding: 20;">
                        <image>
                            <Image url="@../images/icons/stock.png" />
                        </image>
                    </ImageView>
                    <Label text="Stock" styleClass="card-title"/>
                    <Label text="Suivi en temps réel des stocks" styleClass="card-subtitle"/>
                    <Button text="Accéder" onAction="#goToStock" styleClass="card-button"/>
                </VBox>

                <!-- Commandes -->
                <VBox styleClass="card">
                    <ImageView fitWidth="90" fitHeight="90" style="-fx-padding: 20;">
                        <image>
                            <Image url="@../images/icons/orders.png" />
                        </image>
                    </ImageView>
                    <Label text="Commandes" styleClass="card-title"/>
                    <Label text="Gestion des ventes et livraisons" styleClass="card-subtitle"/>
                    <Button text="Accéder" onAction="#goToCommandes" styleClass="card-button"/>
                </VBox>
            </HBox>

            <!-- Bouton Historique -->
            <Button text="Voir l'historique des commandes" onAction="#voirHistorique" styleClass="big-button green"
                    style="-fx-pref-width: 340; -fx-font-size: 18px;"/>
        </VBox>
    </center>

    <bottom>
        <Label text="© AgriConnect 2025 – Tous droits réservés" alignment="CENTER" style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-padding: 25;"/>
    </bottom>

</BorderPane>