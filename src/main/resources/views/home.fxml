<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.HomeController"
            prefWidth="1400" prefHeight="850"
            style="-fx-background-color: #f5f5dc;">

    <!-- SIDEBAR GAUCHE -->
    <left>
        <VBox prefWidth="240"
              style="-fx-background-color: linear-gradient(to bottom, #4a7c3a, #3d6630);">

            <VBox alignment="CENTER" spacing="8"
                  style="-fx-padding: 30 15 25 15; -fx-background-color: rgba(0,0,0,0.15);">
                <Label fx:id="lblEmoji" text="🌾" style="-fx-font-size: 40px;"/>
                <Label text="AgriConnect"
                       style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                <Label text="Fournisseur"
                       style="-fx-text-fill: #c8e6c9; -fx-font-size: 14px;"/>
            </VBox>

            <Region VBox.vgrow="SOMETIMES" prefHeight="30"/>

            <VBox spacing="8" style="-fx-padding: 15 12;">
                <Button text="🏠  Accueil"
                        prefWidth="216" prefHeight="50"
                        style="-fx-background-color: rgba(255,255,255,0.25); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-alignment: center-left; -fx-padding: 12 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
                <Button text="📦  Mes produits" onAction="#goToProduits"
                        prefWidth="216" prefHeight="50"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px; -fx-alignment: center-left; -fx-padding: 12 20; -fx-cursor: hand; -fx-background-radius: 8;"
                        onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited"/>
                <Button text="🛒  Commandes" onAction="#goToCommandes"
                        prefWidth="216" prefHeight="50"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px; -fx-alignment: center-left; -fx-padding: 12 20; -fx-cursor: hand; -fx-background-radius: 8;"
                        onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited"/>
                <Button text="📊  Gestion stock" onAction="#goToStock"
                        prefWidth="216" prefHeight="50"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px; -fx-alignment: center-left; -fx-padding: 12 20; -fx-cursor: hand; -fx-background-radius: 8;"
                        onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited"/>
                <Button text="📜  Historique" onAction="#voirHistorique"
                        prefWidth="216" prefHeight="50"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px; -fx-alignment: center-left; -fx-padding: 12 20; -fx-cursor: hand; -fx-background-radius: 8;"
                        onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox style="-fx-padding: 15 12 25 12;">
                <Button text="➡️  Déconnexion" onAction="#handleDeconnexion"
                        prefWidth="216" prefHeight="45"
                        style="-fx-background-color: rgba(255,100,100,0.2); -fx-text-fill: #ffcccc; -fx-font-size: 14px; -fx-alignment: center-left; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;"
                        onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited"/>
            </VBox>
        </VBox>
    </left>

    <!-- CENTRE -->
    <center>
        <VBox style="-fx-background-color: #f5f5dc;">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: linear-gradient(to right, #5a8c4a, #4a7c3a); -fx-padding: 25 35;">
                <Label text="🌾 Interface Fournisseur"
                       style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10">
                    <VBox alignment="CENTER" prefWidth="90"
                          style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-padding: 8 12;">
                        <Label text="PRODUITS" style="-fx-text-fill: #e8f5e9; -fx-font-size: 9px;"/>
                        <Label fx:id="lblTotalProduits" text="0"
                               style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="90"
                          style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-padding: 8 12;">
                        <Label text="COMMANDES" style="-fx-text-fill: #e8f5e9; -fx-font-size: 9px;"/>
                        <Label fx:id="lblTotalCommandes" text="0"
                               style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="90"
                          style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-padding: 8 12;">
                        <Label text="STOCKS" style="-fx-text-fill: #e8f5e9; -fx-font-size: 9px;"/>
                        <Label fx:id="lblTotalStocks" text="0"
                               style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox spacing="30" style="-fx-padding: 30 40;">

                    <!-- SECTION BIENVENUE -->
                    <HBox spacing="30" alignment="CENTER">
                        <StackPane fx:id="logoContainer"
                                   style="-fx-background-color: white; -fx-background-radius: 100;
                                          -fx-pref-width: 160; -fx-pref-height: 160;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 4);">
                            <ImageView fitWidth="130" fitHeight="130" preserveRatio="true">
                                <image>
                                    <Image url="@../images/logo.png"/>
                                </image>
                            </ImageView>
                        </StackPane>

                        <VBox spacing="15" alignment="CENTER_LEFT">
                            <Label fx:id="lblBienvenue" text=""
                                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                            <Label fx:id="lblSousTitre" text=""
                                   style="-fx-font-size: 15px; -fx-text-fill: #666;"/>
                            <Button text="👤 Mon Profil" onAction="#showProfile"
                                    prefWidth="200" prefHeight="45"
                                    style="-fx-background-color: linear-gradient(to right, #66bb6a, #4caf50);
                                           -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;
                                           -fx-background-radius: 25; -fx-cursor: hand;
                                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 3);"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <VBox spacing="12" alignment="CENTER_LEFT"
                              style="-fx-background-color: white; -fx-padding: 25 30;
                                     -fx-background-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                            <Label text="✨ Fonctionnalités disponibles :"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4a7c3a;"/>
                            <Label text="✅ Gestion du catalogue de produits"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <Label text="✅ Suivi des commandes en temps réel"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <Label text="✅ Gestion du stock avec alertes"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <Label text="✅ Paiement Stripe intégré"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <Label text="✅ Assistant IA Cohere"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <Label text="✅ QR Code produits"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <Label text="✅ Météo temps réel (OpenWeatherMap)"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <Label text="✅ Notifications WhatsApp (Twilio)"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                        </VBox>
                    </HBox>

                    <!-- SÉPARATEUR -->
                    <HBox alignment="CENTER" spacing="15">
                        <Region HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #c8e6c9; -fx-pref-height: 2;"/>
                        <Label text="🕐 Activité Récente"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4a7c3a;"/>
                        <Region HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #c8e6c9; -fx-pref-height: 2;"/>
                    </HBox>

                    <!-- TIMELINE -->
                    <HBox spacing="20" fillHeight="true">

                        <!-- Colonne GAUCHE : Météo -->
                        <VBox spacing="0" prefWidth="380" maxWidth="380" minWidth="380"
                              style="-fx-background-color: white; -fx-padding: 20;
                                     -fx-background-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                            <Label text="🌦️ Météo - Ariana, Tunisie"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1565c0; -fx-padding: 0 0 15 0;"/>
                            <VBox fx:id="timelineCommandes" spacing="8"/>
                        </VBox>

                        <!-- Colonne DROITE : IA -->
                        <VBox spacing="15" HBox.hgrow="ALWAYS">

                            <!-- Chat IA -->
                            <VBox spacing="0" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-padding: 20;
                                         -fx-background-radius: 12;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                                <Label text="🤖 Assistant IA AgriConnect"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4a7c3a; -fx-padding: 0 0 15 0;"/>
                                <VBox fx:id="timelineAlertes" spacing="8"/>
                            </VBox>

                            <!-- Input IA -->
                            <VBox spacing="0"
                                  style="-fx-background-color: white; -fx-padding: 20;
                                         -fx-background-radius: 12;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                                <Label text="💬 Posez votre question"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4a7c3a; -fx-padding: 0 0 15 0;"/>
                                <VBox fx:id="timelineProduits" spacing="8"/>
                            </VBox>

                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>