<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.CommandeController"
            prefWidth="1250" prefHeight="800"
            stylesheets="@../css/style.css">

    <!-- HEADER -->
    <top>
        <VBox styleClass="header">
            <HBox alignment="CENTER" spacing="10">
                <Label text="🛒 Gestion des Commandes" styleClass="header-title"/>
            </HBox>
            <Label text="Créez, suivez et mettez à jour les commandes" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <SplitPane dividerPositions="0.35" styleClass="main-split">

            <!-- FORMULAIRE (GAUCHE) -->
            <VBox styleClass="form-section" alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS">
                <Label text="Nouvelle / Modifier Commande" styleClass="section-title-large"/>

                <VBox spacing="25" styleClass="form-container">
                    <padding>
                        <Insets top="20" right="30" bottom="20" left="30"/>
                    </padding>

                    <GridPane hgap="24" vgap="24" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="160" prefWidth="170" hgrow="NEVER"/>
                            <ColumnConstraints hgrow="SOMETIMES" prefWidth="300"/>
                        </columnConstraints>

                        <Label text="Produit :" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-field"/>
                        <ComboBox fx:id="cbProduit" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="340" prefHeight="50"
                                  promptText="Sélectionnez un produit..." styleClass="input-field input-large"/>

                        <Label text="Quantité :" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-field"/>
                        <TextField fx:id="tfQuantite" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="240" prefHeight="50"
                                   promptText="Ex: 150" styleClass="input-field input-large"/>

                        <Label text="Statut :" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-field"/>
                        <ComboBox fx:id="cbStatut" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="340" prefHeight="50"
                                  promptText="Sélectionnez le statut..." styleClass="input-field input-large"/>
                    </GridPane>

                    <HBox spacing="18" alignment="CENTER" styleClass="button-bar">
                        <Button fx:id="btnAjouter" text="➕ Ajouter" onAction="#handleAjouter" styleClass="button button-success"/>
                        <Button fx:id="btnModifier" text="✏️ Modifier" onAction="#handleModifier" styleClass="button button-warning"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnSupprimer" text="🗑️ Supprimer" onAction="#handleSupprimer" styleClass="button button-danger"/>
                        <Button fx:id="btnActualiser" text="🔄 Actualiser" onAction="#handleActualiser" styleClass="button button-info"/>
                        <!-- NOUVEAU BOUTON PAIEMENT STRIPE -->
                        <Button text="Payer avec Carte" onAction="#handlePayerStripe" styleClass="button button-success"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- TABLEAU (DROITE) -->
            <VBox styleClass="table-section" spacing="20" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="📊 Liste des Commandes" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="table-scroll">
                    <TableView fx:id="tableCommande" styleClass="table-view-modern">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="80" minWidth="70"/>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="180" minWidth="160"/>
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="140" minWidth="120"/>
                            <TableColumn fx:id="colQuantite" text="Quantité" prefWidth="110" minWidth="90"/>
                            <TableColumn fx:id="colProduit" text="Produit" prefWidth="250" minWidth="200"/>
                            <TableColumn fx:id="colClient" text="Client" prefWidth="180" minWidth="140"/>
                        </columns>
                    </TableView>
                </ScrollPane>
            </VBox>

        </SplitPane>
    </center>

    <!-- STATUS BAR -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="status-bar">
            <Label styleClass="status-icon">✅</Label>
            <Label fx:id="lblStatus" text="Prêt - Cliquez sur Actualiser pour charger les données." styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Agriculture Pro © 2026" styleClass="status-footer"/>
        </HBox>
    </bottom>
</BorderPane>