<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.HistoriqueCommandesController"
            prefWidth="1600" prefHeight="900"
            style="-fx-background-color: #f5f5dc;">

    <!-- HEADER VERT AGRICONNECT -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #5a8c4a, #4a7c3a);">
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20 30;">
                <!-- ✅ BOUTON RETOUR -->
                <Button text="🏠 Retour à l'accueil"
                        onAction="#retourAccueil"
                        prefHeight="40" prefWidth="180"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand; -fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 20;"/>

                <Region prefWidth="20"/>

                <Label text="📜" style="-fx-font-size: 32px;"/>
                <VBox spacing="2">
                    <Label text="AgriConnect - Historique des Commandes"
                           style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                    <Label text="Les 20 dernières commandes (les plus récentes en haut)"
                           style="-fx-text-fill: #e8f5e9; -fx-font-size: 13px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStatus"
                       text="Prêt"
                       style="-fx-text-fill: white; -fx-font-size: 13px; -fx-background-color: rgba(0,0,0,0.2); -fx-padding: 8 15; -fx-background-radius: 15;"/>
            </HBox>
        </VBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20" style="-fx-padding: 40 60;" VBox.vgrow="ALWAYS">

            <!-- Titre tableau -->
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label text="📊 Liste des Commandes Récentes"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4a7c3a;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Tableau -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 20;">
                <TableView fx:id="tableHistorique" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-table-cell-border-color: #e0e0e0;">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="80" minWidth="60"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colDate" text="Date" prefWidth="200" minWidth="160"/>
                        <TableColumn fx:id="colProduit" text="Produit" prefWidth="380" minWidth="280"/>
                        <TableColumn fx:id="colQuantite" text="Quantité" prefWidth="130" minWidth="100"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="180" minWidth="140"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Boutons -->
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
                <Button text="🔄 Actualiser"
                        onAction="#actualiser"
                        prefWidth="180" prefHeight="45"
                        style="-fx-background-color: #5bc0de; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 14px;"/>
            </HBox>
        </VBox>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox alignment="CENTER" spacing="15"
              style="-fx-background-color: #4a7c3a; -fx-padding: 12 20;">
            <Label text="© AgriConnect 2025 – Tous droits réservés"
                   style="-fx-text-fill: white; -fx-font-size: 12px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="✅ Système opérationnel"
                   style="-fx-text-fill: #c8e6c9; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>

</BorderPane>