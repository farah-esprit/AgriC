<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.HistoriqueCommandesController"
            prefWidth="1600" prefHeight="900"
            style="-fx-background-color: #f5f5dc;">

    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #5a8c4a, #4a7c3a);">
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20 30;">
                <Button text="🏠 Retour à l'accueil" onAction="#retourAccueil"
                        prefHeight="40" prefWidth="180"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20;
                               -fx-cursor: hand; -fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 20;"/>
                <Region prefWidth="20"/>
                <Label text="📜" style="-fx-font-size: 32px;"/>
                <VBox spacing="2">
                    <Label text="AgriConnect - Historique des Commandes"
                           style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                    <Label text="Les 20 dernières commandes groupées par statut"
                           style="-fx-text-fill: #e8f5e9; -fx-font-size: 13px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="8">
                    <VBox alignment="CENTER" prefWidth="85"
                          style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-padding: 6 10;">
                        <Label text="TOTAL" style="-fx-text-fill: #e8f5e9; -fx-font-size: 9px;"/>
                        <Label fx:id="lblTotal" text="0" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="85"
                          style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-padding: 6 10;">
                        <Label text="EN COURS" style="-fx-text-fill: #e8f5e9; -fx-font-size: 9px;"/>
                        <Label fx:id="lblEnCours" text="0" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="85"
                          style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-padding: 6 10;">
                        <Label text="LIVRÉES" style="-fx-text-fill: #e8f5e9; -fx-font-size: 9px;"/>
                        <Label fx:id="lblLivrees" text="0" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
                <Label fx:id="lblStatus" text="Prêt"
                       style="-fx-text-fill: white; -fx-font-size: 13px;
                              -fx-background-color: rgba(0,0,0,0.2); -fx-padding: 8 15; -fx-background-radius: 15;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30 50;">
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label text="🗂️ Commandes groupées par statut"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4a7c3a;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Actualiser" onAction="#actualiser"
                        prefHeight="36" prefWidth="140"
                        style="-fx-background-color: #5bc0de; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox spacing="5" style="-fx-background-color: transparent;">

                    <Accordion fx:id="accordion">
                        <panes>
                            <TitledPane fx:id="paneEnCours" text="⏳  EN COURS  —">
                                <VBox fx:id="listEnCours" spacing="8" style="-fx-padding: 10;"/>
                            </TitledPane>

                            <TitledPane fx:id="paneValidee" text="✅  VALIDÉE  —">
                                <VBox fx:id="listValidee" spacing="8" style="-fx-padding: 10;"/>
                            </TitledPane>

                            <TitledPane fx:id="paneExpediee" text="🚚  EXPÉDIÉE  —">
                                <VBox fx:id="listExpediee" spacing="8" style="-fx-padding: 10;"/>
                            </TitledPane>

                            <TitledPane fx:id="paneLivree" text="📦  LIVRÉE  —">
                                <VBox fx:id="listLivree" spacing="8" style="-fx-padding: 10;"/>
                            </TitledPane>

                            <TitledPane fx:id="paneAnnulee" text="❌  ANNULÉE  —">
                                <VBox fx:id="listAnnulee" spacing="8" style="-fx-padding: 10;"/>
                            </TitledPane>
                        </panes>
                    </Accordion>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="15"
              style="-fx-background-color: #4a7c3a; -fx-padding: 12 20;">
            <Label text="© AgriConnect 2025 – Tous droits réservés"
                   style="-fx-text-fill: white; -fx-font-size: 12px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="✅ Système opérationnel"
                   style="-fx-text-fill: #c8e6c9; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>

</BorderPane>