<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RegisterController">
    <children>
        <!-- Panneau gauche vert -->
        <StackPane style="-fx-background-color: #28a745;" HBox.hgrow="ALWAYS" />

        <!-- Panneau droit - Formulaire -->
        <StackPane style="-fx-background-color: white;" HBox.hgrow="ALWAYS">
            <children>
                <VBox alignment="CENTER" maxWidth="420.0" spacing="8.0" StackPane.alignment="CENTER">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                    <children>
                        <Label text="Sign Up"><font><Font name="System Bold" size="28.0" /></font></Label>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Nom complet" textFill="#333333"><font><Font size="14.0" /></font></Label>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #28a745; -fx-border-width: 0 0 2 0; -fx-padding: 8;">
                                    <children>
                                        <Label text="✍"><font><Font size="20.0" /></font></Label>
                                        <TextField fx:id="nomField" promptText="Entrez votre nom" style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS">
                                            <font><Font size="14.0" /></font>
                                        </TextField>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Email" textFill="#333333"><font><Font size="14.0" /></font></Label>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #28a745; -fx-border-width: 0 0 2 0; -fx-padding: 8;">
                                    <children>
                                        <Label text="📧"><font><Font size="20.0" /></font></Label>
                                        <TextField fx:id="emailField" promptText="Entrez votre email" style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS">
                                            <font><Font size="14.0" /></font>
                                        </TextField>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Mot de passe" textFill="#333333"><font><Font size="14.0" /></font></Label>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #28a745; -fx-border-width: 0 0 2 0; -fx-padding: 8;">
                                    <children>
                                        <Label text="🔒"><font><Font size="18.0" /></font></Label>
                                        <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe" style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS">
                                            <font><Font size="14.0" /></font>
                                        </PasswordField>
                                        <TextField fx:id="passwordTextField" managed="false" promptText="Entrez votre mot de passe" style="-fx-background-color: transparent; -fx-border-width: 0;" visible="false" HBox.hgrow="ALWAYS">
                                            <font><Font size="14.0" /></font>
                                        </TextField>
                                        <Button fx:id="togglePasswordBtn" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-border-width: 0;" text="👁">
                                            <font><Font size="18.0" /></font>
                                        </Button>
                                    </children>
                                </HBox>
                                <Label fx:id="passwordStrengthLabel" text="" visible="false">
                                    <font><Font size="11.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Confirmer mot de passe" textFill="#333333"><font><Font size="14.0" /></font></Label>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #28a745; -fx-border-width: 0 0 2 0; -fx-padding: 8;">
                                    <children>
                                        <Label text="🔒"><font><Font size="18.0" /></font></Label>
                                        <PasswordField fx:id="confirmPasswordField" promptText="Confirmez votre mot de passe" style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS">
                                            <font><Font size="14.0" /></font>
                                        </PasswordField>
                                        <TextField fx:id="confirmPasswordTextField" managed="false" promptText="Confirmez votre mot de passe" style="-fx-background-color: transparent; -fx-border-width: 0;" visible="false" HBox.hgrow="ALWAYS">
                                            <font><Font size="14.0" /></font>
                                        </TextField>
                                        <Button fx:id="toggleConfirmPasswordBtn" onAction="#toggleConfirmPasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-border-width: 0;" text="👁">
                                            <font><Font size="18.0" /></font>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Type de compte" textFill="#333333"><font><Font size="14.0" /></font></Label>
                                <ChoiceBox fx:id="roleChoice" prefWidth="400.0" style="-fx-font-size: 14px;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="🔒 Vérification de sécurité" textFill="#333333">
                                    <font><Font size="14.0" /></font>
                                </Label>

                                <!-- ✅ Container pour le CAPTCHA avec hauteur fixe -->
                                <AnchorPane fx:id="captchaContainer" maxHeight="166.0" minHeight="80.0" prefHeight="166.0" prefWidth="380.0" style="-fx-border-color: #e0e0e0;                            -fx-border-width: 1;                            -fx-border-radius: 5;                            -fx-background-color: #f9f9f9;                            -fx-background-radius: 5;">
                                </AnchorPane>

                                <Label fx:id="captchaStatusLabel" text="">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </VBox>
                        <Button fx:id="registerButton" onAction="#handleRegister" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #28a745; -fx-background-radius: 25; -fx-cursor: hand;" text="SIGN UP" textFill="WHITE">
                            <font><Font name="System Bold" size="16.0" /></font>
                            <VBox.margin><Insets top="10.0" /></VBox.margin>
                        </Button>

                        <Label fx:id="errorLabel" alignment="CENTER" prefWidth="380.0" textAlignment="CENTER" wrapText="true">
                            <font><Font size="12.0" /></font>
                        </Label>

                        <HBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label text="Vous avez déjà un compte ?" textFill="#666666"><font><Font size="13.0" /></font></Label>
                                <Hyperlink onAction="#handleBackToLogin" text="Se connecter" textFill="#28a745">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Hyperlink>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</HBox>
