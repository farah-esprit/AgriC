<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardAgriculteurController"
            prefWidth="1000"
            prefHeight="600"
            style="-fx-background-color: #F4F6F9;">

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox spacing="25"
              prefWidth="220"
              style="-fx-background-color: linear-gradient(to bottom, #2E8B57, #4CAF50);
                     -fx-padding:25;">

            <Label text="🌱 AgriConnect"
                   style="-fx-text-fill: white;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;"/>

            <Separator style="-fx-background-color: rgba(255,255,255,0.4);"/>

            <Button text="🏠 Accueil"
                    onAction="#handleAccueil"
                    styleClass="sidebar-btn"/>

            <Button text="🌿 Ma culture"
                    onAction="#handleGoToCulture"
                    styleClass="sidebar-btn"/>

            <Button text="🌦 Météo"
                    onAction="#handleWeather"
                    styleClass="sidebar-btn"/>

            <Button text="Diagnostic"
                    onAction="#handleDiagnostic"
                    styleClass="sidebar-btn"/>
            <!-- Bouton pour scanner une plante -->
            <Button text="📷 Scanner une plante"
                    onAction="#handleScanPlant"
                    style="-fx-background-color:#2E8B57; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:10; -fx-padding:10;"/>

            <Button text="🚪 Déconnexion"
                    styleClass="sidebar-btn-logout"/>

        </VBox>
    </left>

    <!-- ================= HEADER ================= -->
    <top>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-background-color:white;
                     -fx-padding:15;
                     -fx-border-color:#ddd;">
            <Label text="Bienvenue Agriculteur 🌾"
                   style="-fx-font-size:14px;"/>
        </HBox>
    </top>

    <!-- ================= CONTENT ================= -->
    <center>
        <StackPane fx:id="contentPane"
                   style="-fx-padding:30;">

            <!-- DASHBOARD HOME -->
            <VBox spacing="25">

                <Label text="🌿 Tableau de Bord"
                       style="-fx-font-size:26px;
                              -fx-font-weight:bold;
                              -fx-text-fill:#2E8B57;"/>

                <!-- Cartes statistiques -->
                <HBox spacing="20">

                    <VBox styleClass="stat-card">
                        <Label text="🌱 Cultures Actives" styleClass="card-title"/>
                        <Label text="12" styleClass="card-value"/>
                    </VBox>

                    <VBox styleClass="stat-card">
                        <Label text="💧 Irrigations" styleClass="card-title"/>
                        <Label text="5 Aujourd'hui" styleClass="card-value"/>
                    </VBox>

                    <VBox styleClass="stat-card">
                        <Label text="🩺 Diagnostics" styleClass="card-title"/>
                        <Label text="3 Alertes" styleClass="card-value"/>
                    </VBox>

                </HBox>

                <!-- Météo actuelle -->
                <VBox spacing="10"
                      style="-fx-background-color:white;
                             -fx-padding:20;
                             -fx-background-radius:15;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15,0,0,5);">

                    <Label text="🌦 Météo actuelle"
                           style="-fx-font-size:18px;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#2E8B57;"/>

                    <Label fx:id="temperatureLabel" text="Température : ..."/>
                    <Label fx:id="windspeedLabel" text="Vitesse du vent : ..."/>
                    <Label fx:id="weatherCodeLabel" text="Conditions : ..."/>

                </VBox>

                <!-- Message du jour -->
                <VBox spacing="10"
                      style="-fx-background-color:white;
                             -fx-padding:20;
                             -fx-background-radius:15;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15,0,0,5);">

                    <Label text="🌾 Conseil du jour"
                           style="-fx-font-size:18px;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#2E8B57;"/>

                    <Label text="Surveillez l’humidité du sol après les dernières pluies pour éviter les maladies fongiques."
                           wrapText="true"
                           style="-fx-text-fill:#555;"/>

                </VBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>