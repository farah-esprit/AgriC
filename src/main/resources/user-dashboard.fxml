<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.UserDashboardController"
            stylesheets="@style.css" prefWidth="1320" prefHeight="780">
    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="10" style="-fx-padding: 22;">
            <Label text="Event Space" styleClass="logo-label">
                <font>
                    <Font name="Segoe UI Bold" size="22"/>
                </font>
            </Label>
            <Label text="Front-office utilisateur" styleClass="sidebar-subtitle"/>
            <Separator/>
            <Button text="Evenements" onAction="#showEvenementsSection" styleClass="sidebar-button" prefWidth="190"/>
            <Button text="Reclamations" onAction="#showReclamationsSection" styleClass="sidebar-button" prefWidth="190"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Deconnexion" onAction="#handleLogout" styleClass="logout-button" prefWidth="190"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="16" styleClass="page-container">
            <Label fx:id="welcomeLabel" styleClass="welcome-label">
                <font>
                    <Font name="Segoe UI Semibold" size="21"/>
                </font>
            </Label>

            <VBox fx:id="evenementsSection" spacing="15">
                <Label text="Mes evenements" styleClass="section-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="evtSearchField" promptText="Rechercher titre/lieu..." styleClass="search-field" prefWidth="280"/>
                    <ComboBox fx:id="evtStatusFilter" prefWidth="180" promptText="Statut"/>
                    <Button text="Filtrer" onAction="#handleSearchEvenements" styleClass="search-button"/>
                    <Button text="Reset" onAction="#handleResetEvenementFilters" styleClass="secondary-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Ajouter" onAction="#handleAddEvenement" styleClass="add-button"/>
                </HBox>

                <TableView fx:id="evenementsTable" styleClass="custom-table" prefHeight="420">
                    <columns>
                        <TableColumn fx:id="evtIdCol" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="evtTitreCol" text="Titre" prefWidth="260"/>
                        <TableColumn fx:id="evtLieuCol" text="Lieu" prefWidth="170"/>
                        <TableColumn fx:id="evtDateDebutCol" text="Date debut" prefWidth="120"/>
                        <TableColumn fx:id="evtDateFinCol" text="Date fin" prefWidth="120"/>
                        <TableColumn fx:id="evtCapaciteCol" text="Capacite" prefWidth="90"/>
                        <TableColumn fx:id="evtStatutCol" text="Statut" prefWidth="130"/>
                    </columns>
                </TableView>

                <HBox spacing="10">
                    <Button text="Modifier" onAction="#handleEditEvenement" styleClass="edit-button"/>
                    <Button text="Supprimer" onAction="#handleDeleteEvenement" styleClass="delete-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Export PDF" onAction="#handleExportEvenementsPDF" styleClass="export-button"/>
                    <Button text="Export CSV" onAction="#handleExportEvenementsCSV" styleClass="export-button"/>
                </HBox>
                <HBox spacing="10">
                    <Button text="Valider adresse + coordonnees" onAction="#handleExternalValidateAddress" styleClass="search-button"/>
                    <Button text="Voir meteo previsionnelle" onAction="#handleExternalWeather" styleClass="approve-button"/>
                    <Button text="Ajouter a mon agenda (ICS)" onAction="#handleExternalExportIcs" styleClass="export-button"/>
                </HBox>
                <TextArea fx:id="eventExternalInfoAreaUser" editable="false" wrapText="true" prefHeight="110" styleClass="stats-text"/>
                <Pagination fx:id="evtPagination" pageCount="1" maxPageIndicatorCount="7"/>
            </VBox>

            <VBox fx:id="reclamationsSection" spacing="15" visible="false" managed="false">
                <Label text="Mes reclamations" styleClass="section-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="reclSearchField" promptText="Rechercher objet/type..." styleClass="search-field" prefWidth="280"/>
                    <ComboBox fx:id="reclStatusFilter" prefWidth="180" promptText="Statut"/>
                    <Button text="Filtrer" onAction="#handleSearchReclamations" styleClass="search-button"/>
                    <Button text="Reset" onAction="#handleResetReclamationFilters" styleClass="secondary-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Ajouter" onAction="#handleAddReclamation" styleClass="add-button"/>
                </HBox>

                <TableView fx:id="reclamationsTable" styleClass="custom-table" prefHeight="420">
                    <columns>
                        <TableColumn fx:id="reclIdCol" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="reclObjetCol" text="Objet" prefWidth="260"/>
                        <TableColumn fx:id="reclDateCol" text="Date" prefWidth="120"/>
                        <TableColumn fx:id="reclStatutCol" text="Statut" prefWidth="130"/>
                        <TableColumn fx:id="reclPrioriteCol" text="Priorite" prefWidth="120"/>
                        <TableColumn fx:id="reclTypeCol" text="Type" prefWidth="180"/>
                    </columns>
                </TableView>

                <HBox spacing="10">
                    <Button text="Modifier" onAction="#handleEditReclamation" styleClass="edit-button"/>
                    <Button text="Supprimer" onAction="#handleDeleteReclamation" styleClass="delete-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Export PDF" onAction="#handleExportReclamationsPDF" styleClass="export-button"/>
                    <Button text="Export CSV" onAction="#handleExportReclamationsCSV" styleClass="export-button"/>
                </HBox>
                <Pagination fx:id="reclPagination" pageCount="1" maxPageIndicatorCount="7"/>
            </VBox>
        </VBox>
    </center>
    <right>
        <VBox styleClass="chat-panel" prefWidth="330" spacing="10" style="-fx-padding: 14;">
            <Label text="Assistant Evenement" styleClass="section-title"/>
            <TextArea fx:id="chatAreaUser" editable="false" wrapText="true" prefHeight="500" styleClass="chat-history"/>
            <TextField fx:id="chatInputUser" promptText="Ecris une demande..." onAction="#handleSendUserChat"/>
            <HBox spacing="8">
                <Button text="Envoyer" onAction="#handleSendUserChat" styleClass="primary-button"/>
                <Button text="Vider" onAction="#handleClearUserChat" styleClass="secondary-button"/>
            </HBox>
            <Label text="Actions rapides" styleClass="sidebar-subtitle"/>
            <VBox spacing="8">
                <Button text="Mes evenements en attente" onAction="#handleQuickUserPendingEvents" styleClass="sidebar-button"/>
                <Button text="Pourquoi rejete ?" onAction="#handleQuickUserRejectedReasons" styleClass="sidebar-button"/>
                <Button text="Aide creation evenement" onAction="#handleQuickStartEventWizard" styleClass="sidebar-button"/>
                <Button text="Creer reclamation (chat)" onAction="#handleQuickStartClaimWizard" styleClass="sidebar-button"/>
                <Button text="Valider lieu + meteo (event selectionne)" onAction="#handleQuickValidateAndWeather" styleClass="sidebar-button"/>
                <Button text="Ajouter a agenda (ICS)" onAction="#handleQuickExportSelectedEventIcs" styleClass="sidebar-button"/>
            </VBox>
        </VBox>
    </right>
</BorderPane>
