                    </children>
                </VBox>

                <Line endX="149.04995727539062" layoutX="123.0" layoutY="602.0" startX="-120.0" stroke="#a6a5a533" strokeWidth="1.5" />

                <!-- PROFIL + DÉCONNEXION (EN BAS) -->
                <VBox spacing="10.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
                    <children>
      
                        <!-- Profil -->
                        <HBox alignment="CENTER_LEFT" onMouseClicked="#handleGoToProfil" prefHeight="58.0" prefWidth="240.0" spacing="12.0" style="-fx-cursor: hand;                                      -fx-background-color: rgba(255,255,255,0.15);                                      -fx-background-radius: 12;                                      -fx-padding: 12;">
                            <children>
                        <ImageView fitHeight="43.0" fitWidth="44.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/hm.png" />
                           </image>
                        </ImageView>
                                <VBox>
                                    <children>
                                        <Label fx:id="userNameLabel" text="Agriculteur">
                                            <font>
                                    <Font name="System Bold" size="13.0" />
                                 </font>
                                        </Label>
                                        <Label text="Profil" textFill="#000000bf">
