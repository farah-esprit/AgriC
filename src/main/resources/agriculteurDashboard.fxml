                                <Label fx:id="welcomeLabel" text="Bienvenue, Agriculteur !" textFill="#1e293b">
                                    <font><Font name="System Bold" size="28.0" /></font>
                                </Label>
                                <Label fx:id="dateLabel" text="samedi 21 février 2026" textFill="#64748b">
                                    <font><Font size="13.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Recherche -->
                        <HBox alignment="CENTER" prefWidth="300.0" spacing="10.0" style="-fx-background-color: white;                                      -fx-background-radius: 25;                                      -fx-padding: 10 20;                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);">
