                <VBox alignment="CENTER" layoutX="38.0" layoutY="103.0" spacing="30.0" style="-fx-background-color: white;                              -fx-background-radius: 20;                              -fx-padding: 50;                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 5);" AnchorPane.leftAnchor="38.0" AnchorPane.rightAnchor="22.799999999999955" AnchorPane.topAnchor="103.0">
                    <children>

                        <!-- Icône agriculteur -->
                        <Label text="👨‍🌾" textFill="#2e7d32">
                            <font><Font size="80.0" /></font>
                        </Label>

                        <!-- Titre -->
                        <Label text="Votre Espace Agricole" textFill="#388e3c">
                            <font><Font name="System Bold" size="32.0" /></font>
                        </Label>

                        <!-- Description -->
                        <Label text="Gérez vos cultures, consultez des experts et commandez vos produits" textAlignment="CENTER" textFill="#64748b">
                            <font><Font size="15.0" /></font>
                        </Label>

                        <!-- CARTES D'ACTION -->
                        <HBox alignment="CENTER" spacing="20.0">
                            <children>

                                <!-- Mes Cultures -->
                                <VBox alignment="CENTER" prefWidth="200.0" spacing="15.0" style="-fx-background-color: linear-gradient(135deg, #4caf50 0%, #2e7d32 100%);                                              -fx-background-radius: 15;                                              -fx-padding: 30;                                              -fx-cursor: hand;                                              -fx-effect: dropshadow(gaussian, rgba(76, 175, 80, 0.3), 12, 0, 0, 5);">
                                    <children>
                                        <Label text="🌾" textFill="#388e3c">
                                            <font><Font size="45.0" /></font>
                                        </Label>
                                        <Label text="Mes Cultures" textAlignment="CENTER">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                        <Label fx:id="culturesCountLabel" text="0 actives" textFill="#000000e5">
                                            <font><Font size="12.0" /></font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- Problèmes -->
                                <VBox alignment="CENTER" prefWidth="200.0" spacing="15.0" style="-fx-background-color: linear-gradient(135deg, #9e9e9e 0%, #616161 100%);                                              -fx-background-radius: 15;                                              -fx-padding: 30;                                              -fx-cursor: hand;                                              -fx-effect: dropshadow(gaussian, rgba(97, 97, 97, 0.3), 12, 0, 0, 5);">
                                    <children>
                                        <Label text="⚠" textFill="#a19e6e">
                                            <font><Font size="45.0" /></font>
                                        </Label>
                                        <Label text="Problèmes" textAlignment="CENTER">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                        <Label fx:id="problemsCountLabel" text="0 signalés" textFill="#000000e5">
                                            <font><Font size="12.0" /></font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- Commandes -->
                                <VBox alignment="CENTER" prefWidth="200.0" spacing="15.0" style="-fx-background-color: linear-gradient(135deg, #fdd835 0%, #f9a825 100%);                                              -fx-background-radius: 15;                                              -fx-padding: 30;                                              -fx-cursor: hand;                                              -fx-effect: dropshadow(gaussian, rgba(249, 168, 37, 0.3), 12, 0, 0, 5);">
                                    <children>
                                        <Label text="🛒" textFill="#b16e6e">
                                            <font><Font size="45.0" /></font>
                                        </Label>
                                        <Label text="Commandes" textAlignment="CENTER">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                        <Label fx:id="ordersCountLabel" text="0 en cours" textFill="#000000e5">
                                            <font><Font size="12.0" /></font>
                                        </Label>
                                    </children>
