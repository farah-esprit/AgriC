                        <HBox fx:id="menuBoutique" alignment="CENTER_LEFT" onMouseClicked="#handleShowBoutique" prefHeight="50.0" prefWidth="240.0" spacing="15.0" style="-fx-cursor: hand;                                      -fx-background-radius: 12;                                      -fx-padding: 0 20;">
