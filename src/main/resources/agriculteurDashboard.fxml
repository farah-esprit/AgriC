                <VBox layoutX="20.0" layoutY="120.0" prefWidth="240.0" spacing="8.0">
                    <children>

                        <!-- Accueil -->
                        <HBox fx:id="menuHome" alignment="CENTER_LEFT" onMouseClicked="#handleShowHome" prefHeight="50.0" prefWidth="240.0" spacing="15.0" style="-fx-cursor: hand; -fx-background-color: #e7e3e3; -fx-background-radius: 12; -fx-padding: 0 20;">
                            <children>
                                <Label text="🏠" textFill="#388e3c">
                                    <font><Font size="22.0" /></font>
                                </Label>
                                <Label text="Accueil" textFill="#388e3c">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- Ma culture -->
                        <HBox fx:id="menuCulture" alignment="CENTER_LEFT" onMouseClicked="#handleShowCulture" prefHeight="50.0" prefWidth="240.0" spacing="15.0" style="-fx-cursor: hand;                                      -fx-background-radius: 12;                                      -fx-padding: 0 20;">
                            <children>
                                <Label text="🌾" textFill="#388e3c">
                                    <font><Font size="22.0" /></font>
                                </Label>
                                <Label text="Ma culture" textFill="#388e3cf2">
                                    <font><Font size="14.0" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- Problèmes -->
