                                  <font>
                              <Font size="14.0" />
                           </font>
                              </ToggleButton>
                                <Button style="-fx-background-color: white;                                                -fx-cursor: hand;                                                -fx-background-radius: 50%;                                                -fx-min-width: 45;                                                -fx-min-height: 45;                                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);" text="🔔">
                                    <font><Font size="18.0" /></font>
                                </Button>
      
                              <!-- Déconnexion -->
                              <Button onMouseClicked="#handleLogout" prefHeight="45.0" prefWidth="42.0" style="-fx-background-color: #000000; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 12;" text="⏻">
                                  <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                              </Button>
                            </children>
                        </HBox>

                    </children>
                </HBox>

