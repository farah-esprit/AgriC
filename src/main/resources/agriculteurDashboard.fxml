                <VBox layoutX="30.0" layoutY="30.0" spacing="5.0">
                    <children>
                        <Label text="AgriConnect" textFill="#388e3c">
                            <font><Font name="System Bold" size="26.0" /></font>
                     <graphic>
                        <ImageView fitHeight="40.0" fitWidth="47.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/logo1.png" />
                           </image>
                        </ImageView>
                     </graphic>
                        </Label>
                        <Label text="Agriculteur" textFill="#000000d9">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <Line endX="132.79998779296875" endY="7.62939453125E-6" layoutX="141.0" layoutY="105.0" startX="-140.00001525878906" startY="7.62939453125E-6" stroke="#a6a5a533" strokeWidth="1.5" />

