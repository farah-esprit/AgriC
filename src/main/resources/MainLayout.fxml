<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.MainLayoutController"
            prefWidth="1200" prefHeight="700"
            style="-fx-background-color:#f4f6f9;">

    <!-- SIDEBAR -->
    <!-- SIDEBAR FIXE À GAUCHE -->
    <left>
        <VBox spacing="20" prefWidth="220" style="-fx-background-color: #2E8B57; -fx-padding: 20;">
            <Label text="🌱 AgriC" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="🏠 Accueil" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="🌱 Cultures" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="💧 Irrigation" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="🩺 Diagnostics" fx:id="btnDiagnostics" style="-fx-background-color: transparent; -fx-text-fill: white;" />
            <Button text="⚙ Paramètres" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
        </VBox>
    </left>

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-padding:15; -fx-background-color:white; -fx-border-color:#ddd;">

            <Label text="Bienvenue, Admin"
                   style="-fx-font-size:14px;"/>
        </HBox>
    </top>

    <!-- CONTENU DYNAMIQUE -->
    <center>
        <StackPane fx:id="contentArea"/>
    </center>

</BorderPane>
