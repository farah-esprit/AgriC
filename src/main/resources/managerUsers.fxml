<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane style="-fx-background-color: #e7e3e3;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ManageUsersController">
    <children>

        <!-- ==================== EN-TÊTE MODERNE ==================== -->
        <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="25.0" spacing="15.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="25.0">
            <children>
                <!-- Icône et titre -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="👥 Gestion des utilisateurs" textFill="#1e293b">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label text="Gérez et supervisez tous les utilisateurs de la plateforme" textFill="#64748b">
                            <font><Font size="13.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <!-- Spacer -->
                <Label HBox.hgrow="ALWAYS" />

                <!-- Bouton Ajouter -->
                <Button onAction="#handleAddUser" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6);                                -fx-text-fill: white;                                -fx-cursor: hand;                                -fx-background-radius: 10;                                -fx-effect: dropshadow(gaussian, rgba(99, 102, 241, 0.3), 10, 0, 0, 4);" text="Nouvel utilisateur">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Button>
            </children>
        </HBox>

        <!-- ==================== LABEL MESSAGE ==================== -->
        <Label fx:id="messageLabel" layoutX="30.0" layoutY="100.0" prefHeight="25.0" prefWidth="900.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="100.0">
            <font><Font name="System Bold" size="13.0" /></font>
        </Label>

        <!-- ==================== BARRE DE RECHERCHE AVANCÉE ==================== -->
        <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="135.0" spacing="12.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="135.0">
            <children>

                <!-- Recherche par nom/email -->
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Recherche" textFill="#64748b">
                            <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <TextField fx:id="searchField" onKeyReleased="#handleSearch" prefHeight="42.0" promptText="🔍 Rechercher par nom, email..." style="-fx-background-color: white;                                           -fx-border-color: #e2e8f0;                                           -fx-border-width: 1.5;                                           -fx-border-radius: 8;                                           -fx-background-radius: 8;                                           -fx-padding: 10;">
                            <font><Font size="13.0" /></font>
                        </TextField>
                    </children>
                </VBox>

                <!-- Filtre par rôle -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="Rôle" textFill="#64748b">
                            <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <ComboBox fx:id="roleFilter" onAction="#handleFilterByRole" prefHeight="42.0" prefWidth="180.0" promptText="Tous les rôles" style="-fx-background-color: white;                                          -fx-border-color: #e2e8f0;                                          -fx-border-width: 1.5;                                          -fx-border-radius: 8;                                          -fx-background-radius: 8;" />
                    </children>
                </VBox>

                <!-- Filtre par état -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="État du compte" textFill="#64748b">
                            <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <ComboBox fx:id="etatFilter" onAction="#handleFilterByEtat" prefHeight="42.0" prefWidth="150.0" promptText="Tous les états" style="-fx-background-color: white;                                          -fx-border-color: #e2e8f0;                                          -fx-border-width: 1.5;                                          -fx-border-radius: 8;                                          -fx-background-radius: 8;" />
                    </children>
                </VBox>

                <!-- Bouton Réinitialiser -->
                <VBox spacing="5.0">
                    <children>
                        <Label text=" " textFill="transparent">
                            <font><Font size="11.0" /></font>
                        </Label>
                    </children>
                </VBox>

            </children>
        </HBox>

                    <!-- ==================== TABLEAU DES UTILISATEURS ==================== -->
        <TableView fx:id="usersTable" layoutX="14.0" layoutY="221.0" style="-fx-background-color: white;                           -fx-background-radius: 12;                           -fx-border-color: #e2e8f0;                           -fx-border-width: 1;                           -fx-border-radius: 12;                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);" AnchorPane.bottomAnchor="149.39999999999998" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="46.799999999999955" AnchorPane.topAnchor="221.0">
            <columns>
                <!-- ❌ COLONNE ID SUPPRIMÉE -->
                <TableColumn fx:id="colNom" prefWidth="200.0" text="👤 Nom" />
                <TableColumn fx:id="colEmail" prefWidth="250.0" text="📧 Email" />
                <TableColumn fx:id="colRole" prefWidth="140.0" text="🎯 Rôle" />
                <TableColumn fx:id="colEtat" prefWidth="130.0" text="📊 État" />
                <TableColumn fx:id="colActions" prefWidth="250.0" text="⚙Actions" />
            </columns>
        </TableView>

    </children>
</AnchorPane>
