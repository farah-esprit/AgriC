<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1222.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ManageUsersController">
    <children>
        <!-- SIDEBAR -->
        <AnchorPane fx:id="sidebar" prefHeight="700.0" prefWidth="118.0" style="-fx-background-color: #388e3c;">
            <children>
                <!-- HEADER -->
                <Label contentDisplay="CENTER" layoutX="14.0" layoutY="14.0" text="🌱AgriConnect" textFill="#f2f2f2">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label layoutX="29.0" layoutY="48.0" text="Administrateur" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Label>
                <Line endX="117.0" layoutX="125.0" layoutY="90.0" startX="-125.00001525878906" startY="7.62939453125E-6" stroke="#666666" strokeWidth="2.0" />

                <!-- MENU NAVIGATION -->
                <VBox layoutX="10.0" layoutY="110.0" prefHeight="350.0" prefWidth="230.0" spacing="5.0">
                    <children>
                        <!-- Tableau de bord -->
                        <HBox onMouseClicked="#handleBackToDashboard" prefHeight="45.0" prefWidth="220.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 8;">
                            <children>
                                <Label text="📊" textFill="WHITE">
                                    <font>
                                        <Font size="22.0" />
                                    </font>
                                </Label>
                                <Label prefHeight="33.0" prefWidth="109.0" text="Tableau de bord" textFill="WHITE">
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                </Label>
                            </children>
                            <padding>
                                <Insets left="12.0" />
                            </padding>
                        </HBox>

                        <!-- Utilisateurs -->
                        <HBox prefHeight="45.0" prefWidth="220.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 8;">
                            <children>
                                <Label text="👥" textFill="WHITE">
                                    <font>
                                        <Font size="22.0" />
                                    </font>
                                </Label>
                                <Label prefHeight="32.0" prefWidth="80.0" text="Utilisateurs" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="15.0" />
                                    </font>
                                </Label>
                            </children>
                            <padding>
                                <Insets left="12.0" />
                            </padding>
                        </HBox>
                    </children>
                </VBox>

                <!-- LIGNE SÉPARATION BAS -->
                <Line endX="117.0" layoutX="125.0" layoutY="530.0" startX="-125.0" stroke="#666666" strokeWidth="2.0" />

                <!-- ZONE INFÉRIEURE : DARK MODE + PROFIL + DÉCONNEXION -->
                <VBox alignment="CENTER" layoutX="10.0" layoutY="545.0" prefHeight="145.0" prefWidth="230.0" spacing="8.0">
                    <children>
                        <!-- DARK/LIGHT MODE TOGGLE -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label fx:id="themeModeIcon" text="☀" textFill="WHITE">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                                <ToggleButton fx:id="themeToggle" onAction="#handleToggleTheme" prefHeight="30.0" prefWidth="60.0" style="-fx-background-color: #81c784; -fx-background-radius: 15; -fx-cursor: hand;" text="🌙">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </ToggleButton>
                                <Label fx:id="themeModeText" text="Clair" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- BOUTON PROFIL -->
                        <Button onMouseClicked="#handleGoToProfil" prefHeight="40.0" prefWidth="210.0" style="-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: white; -fx-border-width: 1; -fx-border-radius: 8;" text="👤 Mon Profil">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>

                        <!-- BOUTON DÉCONNEXION -->
                        <Button onMouseClicked="#handleLogout" prefHeight="40.0" prefWidth="210.0" style="-fx-background-color: #000000; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="🚪 Déconnexion">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
        <!-- ZONE PRINCIPALE -->
        <AnchorPane fx:id="dashboardPane" layoutX="243.0" prefHeight="700.0" prefWidth="957.0" style="-fx-background-color: #f5f5f5;">
            <children>
                <!-- EN-TÊTE -->
                <Label layoutX="30.0" layoutY="30.0" text="👥 Gestion des utilisateurs" textFill="#1a237e">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                </Label>

                <Label fx:id="messageLabel" layoutX="30.0" layoutY="85.0" prefHeight="25.0" prefWidth="920.0" textFill="RED">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <!-- BARRE DE RECHERCHE ET FILTRES -->
                <HBox layoutX="30.0" layoutY="120.0" prefHeight="50.0" prefWidth="920.0" spacing="15.0">
                    <children>
                        <TextField fx:id="searchField" onKeyReleased="#handleSearch" prefHeight="40.0" prefWidth="400.0" promptText="🔍 Rechercher par nom ou email..." style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </TextField>

                        <ComboBox fx:id="roleFilter" onAction="#handleFilterByRole" prefHeight="40.0" prefWidth="200.0" promptText="Filtrer par rôle" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;" />

                        <Button onAction="#handleAddUser" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="➕ Ajouter utilisateur">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>

                        <Button onAction="#handleRefresh" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="🔄 Refresh">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <!-- TABLEAU DES UTILISATEURS -->
                <TableView fx:id="usersTable" layoutX="30.0" layoutY="190.0" prefHeight="450.0" prefWidth="920.0" style="-fx-background-color: white; -fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colNom" prefWidth="180.0" text="Nom" />
                        <TableColumn fx:id="colEmail" prefWidth="220.0" text="Email" />
                        <TableColumn fx:id="colRole" prefWidth="130.0" text="Rôle" />
                        <TableColumn fx:id="colEtat" prefWidth="110.0" text="État" />
                        <TableColumn fx:id="colActions" prefWidth="220.0" text="Actions" />
                    </columns>
                </TableView>

            </children>
        </AnchorPane>
    </children>
</AnchorPane>
