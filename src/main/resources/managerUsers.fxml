<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ManageUsersController">
    <children>
        <!-- SIDEBAR -->
        <AnchorPane prefHeight="700.0" prefWidth="220.0" style="-fx-background-color: #388e3c;">
            <children>
                <Label contentDisplay="CENTER" layoutX="14.0" layoutY="14.0" text="🌱AgriConnect" textFill="#f2f2f2">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label layoutX="29.0" layoutY="48.0" text="Administrateur" textFill="#f8f8f8">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Label>
                <Line endX="105.0" layoutX="115.0" layoutY="90.0" startX="-115.0" stroke="#666666" strokeWidth="2.0" />

                <VBox layoutX="10.0" layoutY="110.0" prefHeight="300.0" prefWidth="220.0" spacing="5.0">
                    <children>
                        <HBox onMouseClicked="#handleBackToDashboard" prefHeight="40.0" prefWidth="200.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 5;">
                            <children>
                                <Label text="📊" textFill="WHITE">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                                <Label prefHeight="31.0" prefWidth="150.0" text="Tableau de bord" textFill="#ffffff">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                            </children>
                            <padding>
                                <Insets left="10.0" />
                            </padding>
                        </HBox>

                        <HBox prefHeight="40.0" prefWidth="200.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 5;">
                            <children>
                                <Label text="👥" textFill="WHITE">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                                <Label prefHeight="31.0" prefWidth="150.0" text="Utilisateurs" textFill="#ffffff">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                            <padding>
                                <Insets left="10.0" />
                            </padding>
                        </HBox>

                        <HBox onMouseClicked="#handleGoToProfil" prefHeight="40.0" prefWidth="200.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 5;">
                            <children>
                                <Label text="👤" textFill="WHITE">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                                <Label prefHeight="31.0" prefWidth="150.0" text="Mon profil" textFill="#ffffff">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                            </children>
                            <padding>
                                <Insets left="10.0" />
                            </padding>
                        </HBox>
                    </children>
                </VBox>

                <Line endX="105.0" layoutX="115.0" layoutY="652.0" startX="-115.0" stroke="#666666" strokeWidth="2.0" />
                <HBox layoutX="10.0" layoutY="660.0" onMouseClicked="#handleLogout" prefHeight="40.0" prefWidth="200.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 5;">
                    <children>
                        <Label text="➜]" textFill="WHITE">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Label>
                        <Label prefHeight="31.0" prefWidth="150.0" text="Déconnexion" textFill="#ffffff">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="10.0" />
                    </padding>
                </HBox>
            </children>
        </AnchorPane>

        <!-- ZONE PRINCIPALE -->
        <AnchorPane fx:id="dashboardPane" layoutX="220.0" prefHeight="700.0" prefWidth="980.0" style="-fx-background-color: #f5f5f5;">
            <children>
                <!-- EN-TÊTE -->
                <Label layoutX="30.0" layoutY="30.0" text="👥 Gestion des utilisateurs" textFill="#1a237e">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                </Label>

                <Label fx:id="messageLabel" layoutX="30.0" layoutY="85.0" prefHeight="25.0" prefWidth="920.0" textFill="RED">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <!-- BARRE DE RECHERCHE ET FILTRES -->
                <HBox layoutX="30.0" layoutY="120.0" prefHeight="50.0" prefWidth="920.0" spacing="15.0">
                    <children>
                        <TextField fx:id="searchField" onKeyReleased="#handleSearch" prefHeight="40.0" prefWidth="400.0" promptText="🔍 Rechercher par nom ou email..." style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </TextField>

                        <ComboBox fx:id="roleFilter" onAction="#handleFilterByRole" prefHeight="40.0" prefWidth="200.0" promptText="Filtrer par rôle" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;" />

                        <Button onAction="#handleAddUser" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="➕ Ajouter utilisateur">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>

                        <Button onAction="#handleRefresh" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="🔄 Refresh">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <!-- TABLEAU DES UTILISATEURS -->
                <TableView fx:id="usersTable" layoutX="30.0" layoutY="190.0" prefHeight="450.0" prefWidth="920.0" style="-fx-background-color: white; -fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colNom" prefWidth="180.0" text="Nom" />
                        <TableColumn fx:id="colEmail" prefWidth="220.0" text="Email" />
                        <TableColumn fx:id="colRole" prefWidth="130.0" text="Rôle" />
                        <TableColumn fx:id="colEtat" prefWidth="110.0" text="État" />
                        <TableColumn fx:id="colActions" prefWidth="220.0" text="Actions" />
                    </columns>
                </TableView>

            </children>
        </AnchorPane>
    </children>
</AnchorPane>
