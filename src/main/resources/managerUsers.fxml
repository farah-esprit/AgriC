<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ManageUsersContentController"
            style="-fx-background-color: #f5f5f5;">
    <children>
        <!-- EN-TÊTE -->
        <Label layoutX="30.0" layoutY="30.0" text="👥 Gestion des utilisateurs" textFill="#1a237e">
            <font><Font name="System Bold" size="32.0" /></font>
        </Label>

        <Label fx:id="messageLabel" layoutX="30.0" layoutY="85.0" prefHeight="25.0" prefWidth="900.0" textFill="RED">
            <font><Font name="System Bold" size="14.0" /></font>
        </Label>

        <!-- BARRE DE RECHERCHE ET FILTRES -->
        <HBox layoutX="30.0" layoutY="120.0" prefHeight="50.0" prefWidth="900.0" spacing="15.0">
            <children>
                <TextField fx:id="searchField" onKeyReleased="#handleSearch" prefHeight="40.0" prefWidth="400.0"
                           promptText="🔍 Rechercher par nom ou email..."
                           style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <font><Font size="14.0" /></font>
                </TextField>

                <ComboBox fx:id="roleFilter" onAction="#handleFilterByRole" prefHeight="40.0" prefWidth="200.0"
                          promptText="Filtrer par rôle"
                          style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;" />

                <Button onAction="#handleAddUser" prefHeight="40.0" prefWidth="180.0"
                        style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;"
                        text="➕ Ajouter utilisateur">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Button>

                <Button onAction="#handleRefresh" prefHeight="40.0" prefWidth="100.0"
                        style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;"
                        text="🔄 Refresh">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Button>
            </children>
        </HBox>

        <!-- TABLEAU DES UTILISATEURS -->
        <TableView fx:id="usersTable" layoutX="30.0" layoutY="190.0"
                   AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0"
                   AnchorPane.topAnchor="190.0" AnchorPane.bottomAnchor="30.0"
                   style="-fx-background-color: white; -fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colNom" prefWidth="180.0" text="Nom" />
                <TableColumn fx:id="colEmail" prefWidth="220.0" text="Email" />
                <TableColumn fx:id="colRole" prefWidth="130.0" text="Rôle" />
                <TableColumn fx:id="colEtat" prefWidth="110.0" text="État" />
                <TableColumn fx:id="colActions" prefWidth="220.0" text="Actions" />
            </columns>
        </TableView>

    </children>
</AnchorPane>