<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #f0f4f0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PlantDiseaseController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
   <Label text="Détection des maladies des plantes">
      <font>
         <Font name="System Bold" size="20.0" />
      </font>
   </Label>

    <!-- Bouton stylé pour choisir l'image -->
    <Button fx:id="btnChooseImage" prefHeight="40" prefWidth="250" style="-fx-background-color: #4CAF50;                    -fx-text-fill: white;                    -fx-font-size: 16px;                    -fx-background-radius: 15px;                    -fx-cursor: hand;" text="📷 Choisir une image de plante">
    </Button>

    <!-- Affichage de l'image sélectionnée avec bordure -->
    <ImageView fx:id="imageView" fitHeight="222.0" fitWidth="400" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 10, 0.5, 0, 0);                       -fx-background-radius: 15px;                       -fx-border-radius: 15px;" />

    <!-- Zone de texte pour afficher le résultat -->
    <TextArea fx:id="resultArea" editable="false" prefHeight="200" prefWidth="400" promptText="Le résultat de l'analyse apparaîtra ici…" style="-fx-background-color: #FFFFFF;                      -fx-border-color: #4CAF50;                      -fx-border-radius: 10px;                      -fx-background-radius: 10px;                      -fx-padding: 10px;                      -fx-font-size: 14px;                      -fx-text-fill: #333333;" wrapText="true" />
</VBox>
