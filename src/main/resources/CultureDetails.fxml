<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" style="-fx-background-color: white;" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.Culture.CultureDetailsController">
    <VBox spacing="0" style="-fx-background-color: white;">

        <VBox spacing="15" style="-fx-background-color: #3E6B27; -fx-padding: 20 20 45 20;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="←" style="-fx-background-radius: 20; -fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label text="Fiche culture" style="-fx-text-fill: #E0E0E0; -fx-font-size: 14px;"/>
            </HBox>

            <Label fx:id="lblNom" text="Blé tendre d'hiver" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <HBox spacing="10">
                <HBox alignment="CENTER" spacing="5" style="-fx-background-color: rgba(255,255,255,0.2); -fx-padding: 5 12; -fx-background-radius: 20;">
                    <Label text="🌾" style="-fx-font-size: 12px;"/>
                    <Label fx:id="lblTypeBadge" text="Céréale" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
                <HBox alignment="CENTER" spacing="5" style="-fx-background-color: rgba(255,255,255,0.2); -fx-padding: 5 12; -fx-background-radius: 20;">
                    <Circle radius="4" fill="#64DC50"/>
                    <Label fx:id="lblStatutBadge" text="Active" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </HBox>
        </VBox>

        <StackPane style="-fx-translate-y: -25;">
            <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 30 30 0 0; -fx-padding: 20;">

                <StackPane>
                    <ImageView fx:id="imgCulture" fitWidth="410" fitHeight="200" preserveRatio="false">
                        <clip>
                            <Rectangle width="410" height="200" arcWidth="30" arcHeight="30"/>
                        </clip>
                    </ImageView>
                    <Rectangle width="410" height="200" arcWidth="30" arcHeight="30" mouseTransparent="true">
                        <fill>
                            <javafx.scene.paint.LinearGradient startX="0.5" startY="1.0" endX="0.5" endY="0.0">
                                <stops>
                                    <javafx.scene.paint.Stop offset="0.0" color="#00000077"/>
                                    <javafx.scene.paint.Stop offset="0.4" color="transparent"/>
                                </stops>
                            </javafx.scene.paint.LinearGradient>
                        </fill>
                    </Rectangle>
                </StackPane>

                <VBox spacing="0" style="-fx-background-color: white; -fx-border-color: #F0F0F0; -fx-border-radius: 15; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>

                    <Label text="INFORMATIONS" style="-fx-text-fill: #8E9AAF; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 0 0 10 0;"/>

                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                        <StackPane style="-fx-background-color: #F1F4F0; -fx-background-radius: 12; -fx-min-width: 45; -fx-min-height: 45;">
                            <Label text="📐" style="-fx-font-size: 18px;"/>
                        </StackPane>
                        <VBox>
                            <Label text="SUPERFICIE" style="-fx-text-fill: #B0B7C3; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            <Label fx:id="lblSuperficie" text="14.5 ha" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2D3436;"/>
                        </VBox>
                    </HBox>
                    <Separator style="-fx-opacity: 0.4;"/>

                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                        <StackPane style="-fx-background-color: #EDF2F7; -fx-background-radius: 12; -fx-min-width: 45; -fx-min-height: 45;">
                            <Label text="📍" style="-fx-font-size: 18px;"/>
                        </StackPane>
                        <VBox>
                            <Label text="LOCALISATION" style="-fx-text-fill: #B0B7C3; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            <Label fx:id="lblLocalisation" text="Parcelle Nord — Hammamet" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2D3436;"/>
                        </VBox>
                    </HBox>
                    <Separator style="-fx-opacity: 0.4;"/>

                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                        <StackPane style="-fx-background-color: #FFF9F0; -fx-background-radius: 12; -fx-min-width: 45; -fx-min-height: 45;">
                            <Label text="📅" style="-fx-font-size: 18px;"/>
                        </StackPane>
                        <VBox>
                            <Label text="DATE DE PLANTATION" style="-fx-text-fill: #B0B7C3; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            <Label text="15 Octobre 2024" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2D3436;"/>
                        </VBox>
                    </HBox>
                    <Separator style="-fx-opacity: 0.4;"/>

                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                        <StackPane style="-fx-background-color: #F3F0FF; -fx-background-radius: 12; -fx-min-width: 45; -fx-min-height: 45;">
                            <Label text="📈" style="-fx-font-size: 18px;"/>
                        </StackPane>
                        <VBox>
                            <Label text="RENDEMENT ESTIMÉ" style="-fx-text-fill: #B0B7C3; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            <Label text="6.2 t/ha" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2D3436;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="8" style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-padding: 15;">
                    <Label text="NOTES" style="-fx-text-fill: #8E9AAF; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                    <Label wrapText="true" text="Sol argileux bien drainé. Dernière irrigation le 10/02. Traitement fongicide prévu début mars avant montaison."
                           style="-fx-text-fill: #4A5568; -fx-font-size: 13px; -fx-line-spacing: 3;"/>
                </VBox>

                <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10 0 20 0;">
                    <Button text="✕ Fermer" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: #F1F3F5; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 12;"/>

                    <Button fx:id="btnFaireDiagnostic" text="🩺 Faire un diagnostic" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: #E67E22; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(230,126,34,0.3), 10, 0, 0, 4);"/>
                </HBox>

            </VBox>
        </StackPane>
    </VBox>
</ScrollPane>