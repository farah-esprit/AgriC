<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.Culture.CultureDetailsController"
            prefWidth="450" prefHeight="550"
            style="-fx-background-color:#f4f6f9;">

    <!-- HEADER -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-padding: 15;
                     -fx-background-color:#2E8B57;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 2);">
            <Label text="🌱 Détails de la culture"
                   style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:white;"/>
        </HBox>
    </top>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding:20;">

            <!-- Carte moderne -->
            <VBox spacing="15" alignment="CENTER"
                  style="-fx-background-color:white;
                         -fx-padding:20;
                         -fx-background-radius:15;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 15, 0, 0, 5);">

                <!-- Image -->
                <ImageView fx:id="imgCulture" fitWidth="250" fitHeight="180" preserveRatio="true"
                           style="-fx-border-radius:10; -fx-border-color:#d0d0d0;"/>

                <!-- Labels -->
                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="lblNom" text="Nom: " style="-fx-font-size:18px; -fx-font-weight:bold;"/>
                    <Label fx:id="lblType" text="Type: " style="-fx-font-size:14px; -fx-text-fill:#555555;"/>
                    <Label fx:id="lblSuperficie" text="Superficie: " style="-fx-font-size:14px; -fx-text-fill:#555555;"/>
                    <Label fx:id="lblLocalisation" text="Localisation: " style="-fx-font-size:14px; -fx-text-fill:#555555;"/>
                </VBox>
            </VBox>
        </VBox>
    </center>

    <!-- BOUTONS FERMER + DIAGNOSTIC -->
    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding:15;">

            <Button fx:id="btnFaireDiagnostic" text="🩺 Faire Diagnostic"
                    style="-fx-background-color:#FF9800;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;
                           -fx-background-radius:10;
                           -fx-pref-width:140;
                           -fx-pref-height:35;"/>

            <Button text="✖ Fermer" onAction="#fermer"
                    style="-fx-background-color:#2E8B57;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;
                           -fx-background-radius:10;
                           -fx-pref-width:100;
                           -fx-pref-height:35;"/>
        </HBox>
    </bottom>
</BorderPane>
