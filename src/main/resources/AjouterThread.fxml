<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<ScrollPane xmlns="http://javafx.com/fxml/"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ForumAddThreadController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="root-background"
            stylesheets="@agro-style.css">

    <!-- PAGE WRAPPER -->
    <VBox alignment="TOP_CENTER" spacing="0"
          style="-fx-padding: 36 48 48 48; -fx-background-color: #F0F2F5;">

        <!-- ══ TOPBAR STRIP (green, like sidebar) ══ -->
        <Region styleClass="form-topbar" maxWidth="Infinity"/>

        <!-- ══ FORM CARD ══ -->
        <VBox fx:id="mainContainer"
              spacing="24"
              styleClass="form-card"
              style="-fx-margin-top: 0;">

            <!-- ── HEADER ─────────────────────────── -->
            <VBox spacing="10">
                <Label text="🌱 Nouveau Sujet" styleClass="header-title"/>
                <Region styleClass="header-accent" maxWidth="Infinity"/>
            </VBox>

            <Separator styleClass="section-sep"/>

            <!-- ── CATEGORY ──────────────────────── -->
            <VBox spacing="8">
                <Label text="📂 Catégorie *" styleClass="section-label"/>
                <ComboBox fx:id="categorieComboBox"
                          promptText="Sélectionnez une catégorie"
                          maxWidth="Infinity"
                          styleClass="input-field">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="🌾 Cultures &amp; Récoltes"/>
                            <String fx:value="🐄 Élevage &amp; Animaux"/>
                            <String fx:value="🚜 Matériel &amp; Équipement"/>
                            <String fx:value="🌱 Semences &amp; Plantation"/>
                            <String fx:value="💧 Irrigation &amp; Eau"/>
                            <String fx:value="🧪 Engrais &amp; Traitements"/>
                            <String fx:value="📊 Agroéconomie &amp; Marché"/>
                            <String fx:value="🌍 Agroécologie &amp; Bio"/>
                            <String fx:value="🔧 Réparations &amp; Astuces"/>
                            <String fx:value="❓ Questions Générales"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>

            <!-- ── TAGS ───────────────────────────── -->
            <VBox spacing="8">
                <Label text="🏷️ Tags (mots-clés)" styleClass="section-label"/>
                <TextField fx:id="tagsField"
                           promptText="Ex: tomates, arrosage, bio..."
                           styleClass="input-field"/>
            </VBox>

            <!-- ── TITLE ──────────────────────────── -->
            <VBox spacing="8">
                <Label text="🌱 Titre du sujet *" styleClass="section-label"/>
                <TextField fx:id="TitreAjoutThread"
                           promptText="Ex: Comment améliorer la croissance des tomates ?"
                           styleClass="input-field"/>
            </VBox>

            <!-- ── CONTENT ────────────────────────── -->
            <VBox spacing="8">
                <Label text="📝 Contenu *" styleClass="section-label"/>
                <TextArea fx:id="contenuAjoutThread"
                          wrapText="true"
                          prefHeight="180"
                          styleClass="input-field"/>
            </VBox>

            <Separator styleClass="section-sep"/>

            <!-- ── IMAGE SECTION ──────────────────── -->
            <VBox spacing="14">
                <Label text="🖼️ Image principale (optionnelle)" styleClass="section-label"/>

                <HBox spacing="12">
                    <Button text="📁 Choisir une image"
                            onAction="#importImage"
                            styleClass="image-button"/>
                    <Button text="🗑️ Supprimer"
                            onAction="#AnnulerLimageImporterAjTh"
                            styleClass="cancel-button"/>
                </HBox>

                <StackPane fx:id="threadImageContainer"
                           minHeight="220"
                           styleClass="image-container">
                    <ImageView fx:id="imagePreview"
                               fitWidth="320"
                               fitHeight="280"
                               preserveRatio="true"
                               visible="false"
                               onMouseClicked="#openImageModal"/>
                    <Label fx:id="noImageLabel"
                           text="⫸ Aucune image sélectionnée ⫷"
                           styleClass="section-label"/>
                </StackPane>
            </VBox>

            <Separator styleClass="section-sep"/>

            <!-- ── ACTIONS ────────────────────────── -->
            <HBox spacing="14" alignment="CENTER_RIGHT">
                <Button text="✖ Annuler"
                        onAction="#AnnulerAjoutThread"
                        styleClass="cancel-button"/>
                <Button text="🌿 Publier le sujet"
                        onAction="#AjouterThread"
                        defaultButton="true"
                        styleClass="primary-button"/>
            </HBox>

            <!-- ── FOOTER ─────────────────────────── -->
            <Label text="🌱 Ensemble, cultivons nos connaissances !"
                   styleClass="footer-text"
                   maxWidth="Infinity"
                   style="-fx-alignment:center;-fx-text-alignment:center;"/>

        </VBox>
    </VBox>
</ScrollPane>
