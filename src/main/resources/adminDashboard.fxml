<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="700.0" minWidth="1200.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardAdminController">
    <children>
        <!-- SIDEBAR -->
        <AnchorPane fx:id="sidebar" prefWidth="250.0"
                    style="-fx-background-color: #388e3c;"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
            <children>
                <Label contentDisplay="CENTER" layoutX="14.0" layoutY="14.0" text="🌱AgriConnect" textFill="#f2f2f2">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
                <Label layoutX="29.0" layoutY="48.0" text="Administrateur" textFill="WHITE">
                    <font><Font name="System Bold" size="15.0" /></font>
                </Label>
                <Line endX="124.0" layoutX="125.0" layoutY="90.0" startX="-125.0" stroke="#666666" strokeWidth="2.0" />
                <VBox layoutX="10.0" layoutY="110.0" prefWidth="230.0" spacing="5.0">
                    <children>
                        <HBox fx:id="menuDashboard" prefHeight="45.0" prefWidth="220.0" spacing="10.0"
                              style="-fx-cursor: hand; -fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 8;">
                            <children>
                                <Label text="📊" textFill="WHITE"><font><Font size="22.0" /></font></Label>
                                <Label text="Tableau de bord" textFill="WHITE"><font><Font name="System Bold" size="15.0" /></font></Label>
                            </children>
                            <padding><Insets left="12.0" /></padding>
                        </HBox>
                        <HBox fx:id="menuUsers" onMouseClicked="#openManageUsers" prefHeight="45.0" prefWidth="220.0" spacing="10.0"
                              style="-fx-cursor: hand; -fx-background-radius: 8;">
                            <children>
                                <Label text="👥" textFill="WHITE"><font><Font size="22.0" /></font></Label>
                                <Label text="Utilisateurs" textFill="WHITE"><font><Font size="15.0" /></font></Label>
                            </children>
                            <padding><Insets left="12.0" /></padding>
                        </HBox>
                    </children>
                </VBox>
                <Line endX="126.0" layoutX="125.0" layoutY="530.0" startX="-125.0" stroke="#666666" strokeWidth="2.0" />
                <VBox alignment="CENTER" layoutX="10.0" layoutY="545.0" prefWidth="230.0" spacing="8.0">
                    <children>
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label fx:id="themeModeIcon" text="☀" textFill="WHITE"><font><Font size="20.0" /></font></Label>
                                <ToggleButton fx:id="themeToggle" onAction="#handleToggleTheme" prefHeight="30.0" prefWidth="60.0"
                                             style="-fx-background-color: #81c784; -fx-background-radius: 15; -fx-cursor: hand;" text="🌙">
                                    <font><Font size="14.0" /></font>
                                </ToggleButton>
                                <Label fx:id="themeModeText" text="Clair" textFill="WHITE"><font><Font name="System Bold" size="12.0" /></font></Label>
                            </children>
                        </HBox>
                        <Button onMouseClicked="#handleGoToProfil" prefHeight="40.0" prefWidth="210.0"
                                style="-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: white; -fx-border-width: 1; -fx-border-radius: 8;"
                                text="👤 Mon Profil">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                        <Button onMouseClicked="#handleLogout" prefHeight="40.0" prefWidth="210.0"
                                style="-fx-background-color: #000000; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🚪 Déconnexion">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <!-- CONTENU PRINCIPAL -->
        <AnchorPane fx:id="dashboardPane"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" layoutX="51.0" layoutY="16.0" prefHeight="70.0" spacing="20.0"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                      AnchorPane.leftAnchor="51.0" AnchorPane.rightAnchor="30.0">
                    <children>
                        <Label text="📊"><font><Font size="40.0" /></font></Label>
                        <VBox>
                            <children>
                                <Label text="Tableau de bord Administrateur" textFill="#1a237e">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                                <Label fx:id="welcomeLabel" text="Bienvenue, Admin !" textFill="#666666">
                                    <font><Font size="14.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                    <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                </HBox>

                <HBox layoutX="41.0" layoutY="120.0" prefHeight="164.0" spacing="20.0"
                      AnchorPane.leftAnchor="41.0" AnchorPane.rightAnchor="30.0">
                    <children>
                        <VBox alignment="CENTER" prefHeight="160.0" prefWidth="220.0" spacing="15.0"
                              style="-fx-background-color: linear-gradient(to bottom right, #667eea, #764ba2); -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="👥" textFill="WHITE"><font><Font size="40.0" /></font></Label>
                                        <VBox>
                                            <children>
                                                <Label text="Total" textFill="rgba(255,255,255,0.8)"><font><Font name="System Bold" size="12.0" /></font></Label>
                                                <Label text="Utilisateurs" textFill="rgba(255,255,255,0.8)"><font><Font size="11.0" /></font></Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <Label fx:id="totalUsersLabel" text="0" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                                <Label text="Comptes enregistrés" textFill="rgba(255,255,255,0.7)"><font><Font size="11.0" /></font></Label>
                            </children>
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="160.0" prefWidth="220.0" spacing="15.0"
                              style="-fx-background-color: linear-gradient(to bottom right, #56ab2f, #a8e063); -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="🌱" textFill="WHITE"><font><Font size="40.0" /></font></Label>
                                        <Label text="Agriculteurs" textFill="WHITE"><font><Font name="System Bold" size="14.0" /></font></Label>
                                    </children>
                                </HBox>
                                <Label fx:id="agriculteursLabel" text="0" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                                <Label text="Producteurs actifs" textFill="rgba(255,255,255,0.7)"><font><Font size="11.0" /></font></Label>
                            </children>
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="160.0" prefWidth="220.0" spacing="15.0"
                              style="-fx-background-color: linear-gradient(to bottom right, #f093fb, #f5576c); -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="🎓" textFill="WHITE"><font><Font size="40.0" /></font></Label>
                                        <Label text="Experts" textFill="WHITE"><font><Font name="System Bold" size="14.0" /></font></Label>
                                    </children>
                                </HBox>
                                <Label fx:id="expertsLabel" text="0" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                                <Label text="Conseillers agricoles" textFill="rgba(255,255,255,0.7)"><font><Font size="11.0" /></font></Label>
                            </children>
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="160.0" prefWidth="220.0" spacing="15.0"
                              style="-fx-background-color: linear-gradient(to bottom right, #4facfe, #00f2fe); -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="🛒" textFill="WHITE"><font><Font size="40.0" /></font></Label>
                                        <Label text="Fournisseurs" textFill="WHITE"><font><Font name="System Bold" size="14.0" /></font></Label>
                                    </children>
                                </HBox>
                                <Label fx:id="fournisseursLabel" text="0" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                                <Label text="Partenaires commerciaux" textFill="rgba(255,255,255,0.7)"><font><Font size="11.0" /></font></Label>
                            </children>
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </VBox>
                    </children>
                </HBox>

                <HBox layoutX="41.0" layoutY="348.0" prefHeight="140.0" spacing="20.0"
                      AnchorPane.leftAnchor="41.0" AnchorPane.rightAnchor="30.0">
                    <children>
                        <VBox alignment="CENTER" prefHeight="140.0" prefWidth="295.0" spacing="10.0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #4caf50; -fx-border-width: 2; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                            <children>
                                <Label text="✅ Comptes Actifs" textFill="#4caf50"><font><Font name="System Bold" size="16.0" /></font></Label>
                                <Label fx:id="comptesActifsLabel" text="0" textFill="#4caf50"><font><Font name="System Bold" size="36.0" /></font></Label>
                            </children>
                            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="140.0" prefWidth="295.0" spacing="10.0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #ff5722; -fx-border-width: 2; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                            <children>
                                <Label text="🔒 Comptes Bloqués" textFill="#ff5722"><font><Font name="System Bold" size="16.0" /></font></Label>
                                <Label fx:id="comptesBloquesLabel" text="0" textFill="#ff5722"><font><Font name="System Bold" size="36.0" /></font></Label>
                            </children>
                            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="140.0" prefWidth="295.0" spacing="10.0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #2196f3; -fx-border-width: 2; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                            <children>
                                <Label text="🆕 Nouveaux (7j)" textFill="#2196f3"><font><Font name="System Bold" size="16.0" /></font></Label>
                                <Label fx:id="nouveauxLabel" text="0" textFill="#2196f3"><font><Font name="System Bold" size="36.0" /></font></Label>
                            </children>
                            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        </VBox>
                    </children>
                </HBox>

                <VBox layoutX="41.0" layoutY="510.0" spacing="15.0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                      AnchorPane.leftAnchor="41.0" AnchorPane.rightAnchor="30.0">
                    <children>
                        <Label text="⚡ Actions rapides" textFill="#1a237e"><font><Font name="System Bold" size="18.0" /></font></Label>
                        <HBox spacing="15.0">
                            <children>
                                <Button onAction="#handleRefresh" prefHeight="50.0" prefWidth="280.0"
                                        style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"
                                        text="🔄 Actualiser données">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
