<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane fx:controller="org.example.controllers.Diagnostic.DiagnosticController"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f4f6f9;">

    <!-- ================= HEADER ================= -->
    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-padding:25;
                 -fx-background-color: linear-gradient(to right, #2E8B57, #4CAF50);
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 15, 0, 0, 3);">

            <Label fx:id="lblCulture"
                   text="🌿 Diagnostic Intelligent"
                   style="-fx-font-size:28px;
                      -fx-text-fill:white;
                      -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- ================= CONTENT ================= -->
    <center>
        <HBox spacing="25" style="-fx-padding:25;" HBox.hgrow="ALWAYS">

            <!-- ================= LEFT PANEL ================= -->
            <ScrollPane fitToWidth="true"
                        HBox.hgrow="ALWAYS"
                        vbarPolicy="AS_NEEDED"
                        style="-fx-background-color:transparent;">

                <content>
                    <VBox spacing="18"
                          style="-fx-background-color:white;
                                 -fx-padding:30;
                                 -fx-background-radius:20;
                                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 5);">

                        <Label text="📝 Informations Diagnostic"
                               style="-fx-font-size:20px;
              -fx-font-weight:bold;
              -fx-text-fill:#2E8B57;"/>


                        <!-- Champs -->
                        <TextField fx:id="txtEtat" promptText="État de la culture" styleClass="modern-field"/>
                        <TextField fx:id="txtSymptomes" promptText="Symptômes observés" styleClass="modern-field"/>
                        <TextField fx:id="txtInformations" promptText="Informations complémentaires" styleClass="modern-field"/>

                        <Separator/>

                        <Label text="🤖 Analyse IA"
                               style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#2e7d32;"/>

                        <TextField fx:id="txtPlantType" promptText="Type de plante" styleClass="modern-field"/>
                        <TextField fx:id="txtLeafColor" promptText="Couleur feuille" styleClass="modern-field"/>
                        <TextField fx:id="txtSpotSize" promptText="Taille des taches" styleClass="modern-field"/>
                        <TextField fx:id="txtHumidity" promptText="Humidité (%)" styleClass="modern-field"/>
                        <TextField fx:id="txtTemperature" promptText="Température (°C)" styleClass="modern-field"/>

                        <HBox spacing="15">
                            <Button text="💾 Sauvegarder"
                                    onAction="#sauvegarderDiagnostic"
                                    styleClass="modern-btn"/>
                            <Button text="🖨 Imprimer"
                                    onAction="#imprimerDiagnostic"
                                    styleClass="modern-btn-secondary"/>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>

            <!-- ================= RIGHT PANEL ================= -->
            <VBox spacing="20"
                  HBox.hgrow="ALWAYS"
                  maxWidth="550"
                  style="-fx-background-color:white;
                         -fx-padding:25;
                         -fx-background-radius:20;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 5);">

                <Label text="📊 Historique des diagnostics"
                       style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#2e7d32;"/>

                <ScrollPane fitToWidth="true"
                            vbarPolicy="AS_NEEDED"
                            hbarPolicy="NEVER"
                            VBox.vgrow="ALWAYS"
                            style="-fx-background-color:transparent;">

                    <content>
                        <FlowPane fx:id="flowHistorique"
                                  hgap="15"
                                  vgap="15"
                                  prefWrapLength="450"/>
                    </content>

                </ScrollPane>
            </VBox>

        </HBox>
    </center>

</BorderPane>
