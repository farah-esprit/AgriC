<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="org.example.controllers.Diagnostic.DiagnosticController"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="600" prefHeight="600"
            style="-fx-padding:20; -fx-background-color:white;">

    <top>
        <Label fx:id="lblCulture" style="-fx-font-size:20px; -fx-font-weight:bold;"/>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding:10;">
            <TextField fx:id="txtEtat" promptText="État de la culture"/>
            <TextField fx:id="txtSymptomes" promptText="Symptômes observés"/>
            <TextField fx:id="txtInformations" promptText="Informations complémentaires"/>
            <Button fx:id="btnChoisirPhoto" text="Choisir Photo" onAction="#choisirPhoto"/>
            <Button fx:id="btnSauvegarder" text="💾 Sauvegarder" onAction="#sauvegarderDiagnostic"/>

            <Label text="Historique des diagnostics :" style="-fx-font-size:16px; -fx-font-weight:bold;"/>
            <TableView fx:id="tblHistorique" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
                    <TableColumn fx:id="colEtat" text="État" prefWidth="120"/>
                    <TableColumn fx:id="colSymptomes" text="Symptômes" prefWidth="150"/>
                    <TableColumn fx:id="colInformations" text="Infos Complémentaires" prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
