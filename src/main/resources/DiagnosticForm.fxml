<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="org.example.controllers.Diagnostic.DiagnosticController"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1100" prefHeight="750"
            style="-fx-background-color: #F4F7F6;"> <top>
    <VBox spacing="10" style="-fx-background-color: #3E6B27; -fx-padding: 25 35 45 35;">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button text="←" style="-fx-background-radius: 20; -fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Label text="Outil de Diagnostic" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px;"/>
        </HBox>
        <Label fx:id="lblCulture" text="🌿 Diagnostic Intelligent"
               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </VBox>
</top>

    <center>
        <HBox spacing="30" style="-fx-padding: 0 35 30 35; -fx-translate-y: -25;">

            <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" vbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox spacing="25" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">

                    <VBox spacing="15">
                        <Label text="📝 OBSERVATIONS DE TERRAIN" style="-fx-text-fill: #8E9AAF; -fx-font-weight: bold; -fx-font-size: 12px; -fx-letter-spacing: 1px;"/>

                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #F8FAFC; -fx-padding: 10; -fx-background-radius: 12; -fx-border-color: #EDF2F7; -fx-border-radius: 12;">
                            <Label text="📋" style="-fx-font-size: 16px;"/>
                            <TextField fx:id="txtEtat" promptText="État global de la culture..." HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-font-size: 14px;"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #F8FAFC; -fx-padding: 10; -fx-background-radius: 12; -fx-border-color: #EDF2F7; -fx-border-radius: 12;">
                            <Label text="🔍" style="-fx-font-size: 16px;"/>
                            <TextField fx:id="txtSymptomes" promptText="Symptômes (ex: taches, flétrissement...)" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-font-size: 14px;"/>
                        </HBox>
                    </VBox>

                    <Separator/>

                    <VBox spacing="15">
                        <Label text="🤖 PARAMÈTRES POUR L'ANALYSE IA" style="-fx-text-fill: #3E6B27; -fx-font-weight: bold; -fx-font-size: 12px;"/>

                        <GridPane hgap="15" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50"/>
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Type de plante" style="-fx-text-fill: #A0AEC0; -fx-font-size: 11px;"/>
                                <TextField fx:id="txtPlantType" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 10;"/>
                            </VBox>

                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Couleur des feuilles" style="-fx-text-fill: #A0AEC0; -fx-font-size: 11px;"/>
                                <TextField fx:id="txtLeafColor" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 10;"/>
                            </VBox>

                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Humidité (%)" style="-fx-text-fill: #A0AEC0; -fx-font-size: 11px;"/>
                                <TextField fx:id="txtHumidity" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 10;"/>
                            </VBox>

                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Température (°C)" style="-fx-text-fill: #A0AEC0; -fx-font-size: 11px;"/>
                                <TextField fx:id="txtTemperature" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 10;"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                        <Button text="🖨 Imprimer" onAction="#imprimerDiagnostic"
                                style="-fx-background-color: #F1F3F5; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 12;"/>
                        <Button text="💾 Sauvegarder le Diagnostic" onAction="#sauvegarderDiagnostic"
                                style="-fx-background-color: #E67E22; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(230,126,34,0.3), 10, 0, 0, 4);"/>
                    </HBox>
                </VBox>
            </ScrollPane>

            <VBox spacing="20" maxWidth="450" minWidth="350"
                  style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane style="-fx-background-color: #F3F0FF; -fx-padding: 8; -fx-background-radius: 10;">
                        <Label text="📊" style="-fx-font-size: 16px;"/>
                    </StackPane>
                    <Label text="HISTORIQUE" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2D3436;"/>
                </HBox>

                <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <FlowPane fx:id="flowHistorique" hgap="10" vgap="10"/>
                </ScrollPane>
            </VBox>
        </HBox>
    </center>
</BorderPane>