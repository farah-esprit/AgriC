<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EditProfilAdminController">
    <children>
        <!-- SIDEBAR -->
        <AnchorPane fx:id="sidebar" prefHeight="700.0" prefWidth="250.0" style="-fx-background-color: #388e3c;">
            <children>
                <!-- HEADER -->
                <Label contentDisplay="CENTER" layoutX="14.0" layoutY="14.0" text="🌱AgriConnect" textFill="#f2f2f2">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label layoutX="29.0" layoutY="48.0" text="Administrateur">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Label>
                <Line endX="125.39999389648438" endY="7.62939453125E-6" layoutX="125.0" layoutY="90.0" startX="-125.00000762939453" startY="7.62939453125E-6" stroke="#666666" strokeWidth="2.0" />

                <!-- MENU NAVIGATION -->
                <VBox layoutX="10.0" layoutY="110.0" prefHeight="350.0" prefWidth="230.0" spacing="5.0">
                    <children>
                        <!-- Tableau de bord -->
                        <HBox onMouseClicked="#handleBackToDashboard" prefHeight="45.0" prefWidth="220.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 8;">
                            <children>
                                <Label text="📊" textFill="WHITE">
                                    <font>
                                        <Font size="22.0" />
                                    </font>
                                </Label>
                                <Label prefHeight="31.0" prefWidth="157.0" text="Tableau de bord" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="15.0" />
                                    </font>
                                </Label>
                            </children>
                            <padding>
                                <Insets left="12.0" />
                            </padding>
                        </HBox>
                        <HBox onMouseClicked="#openManageUsers" prefHeight="45.0" prefWidth="220.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 8;">
                            <children>
                                <Label text="👥" textFill="WHITE">
                                    <font>
                                        <Font size="22.0" />
                                    </font>
                                </Label>
                                <Label prefHeight="38.0" prefWidth="74.0" text="Utilisateurs" textFill="WHITE">
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                </Label>
                            </children>
                            <padding>
                                <Insets left="12.0" />
                            </padding>
                        </HBox>
                    </children>
                </VBox>

                <!-- LIGNE SÉPARATION BAS -->
                <Line endX="127.00001525878906" layoutX="125.0" layoutY="530.0" startX="-125.00001525878906" stroke="#666666" strokeWidth="2.0" />

                <!-- ZONE INFÉRIEURE : DARK MODE + PROFIL + DÉCONNEXION -->
                <VBox alignment="CENTER" layoutX="10.0" layoutY="545.0" prefHeight="145.0" prefWidth="230.0" spacing="8.0">
                    <children>
                        <!-- DARK/LIGHT MODE TOGGLE -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label fx:id="themeModeIcon" text="☀" textFill="WHITE">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                                <ToggleButton fx:id="themeToggle" onAction="#handleToggleTheme" prefHeight="30.0" prefWidth="60.0" style="-fx-background-color: #81c784; -fx-background-radius: 15; -fx-cursor: hand;" text="🌙">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </ToggleButton>
                                <Label fx:id="themeModeText" text="Clair" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- BOUTON PROFIL -->
                        <Button onAction="#handleAnnuler" prefHeight="40.0" prefWidth="210.0" style="-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: white; -fx-border-width: 1; -fx-border-radius: 8;" text="👤 Mon Profil">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>

                        <!-- BOUTON DÉCONNEXION -->
                        <Button onMouseClicked="#handleLogout" prefHeight="40.0" prefWidth="210.0" style="-fx-background-color: #000000; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="🚪 Déconnexion">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <!-- CONTENU PRINCIPAL -->
        <AnchorPane layoutX="250.0" prefHeight="700.0" prefWidth="950.0" style="-fx-background-color: #f5f5f5;">
            <children>
                <Label layoutX="30.0" layoutY="30.0" text="✏Modifier mon profil" textFill="#1a237e">
                    <font><Font name="System Bold" size="32.0" /></font>
                </Label>

                <Label fx:id="messageLabel" layoutX="30.0" layoutY="85.0" prefHeight="25.0" prefWidth="890.0">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>

                <!-- FORMULAIRE DE MODIFICATION -->
                <VBox layoutX="30.0" layoutY="130.0" prefHeight="520.0" prefWidth="890.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <children>
                        <Label text="📝 Informations personnelles" textFill="#1a237e">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>

                        <!-- NOM -->
                        <VBox spacing="8.0">
                            <Label text="Nom complet *" textFill="#666666">
                                <font><Font size="14.0" /></font>
                            </Label>
                            <TextField fx:id="nomField" prefHeight="45.0" promptText="Entrez votre nom complet" style="-fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14;">
                            </TextField>
                        </VBox>

                        <!-- EMAIL -->
                        <VBox spacing="8.0">
                            <Label text="Adresse email *" textFill="#666666">
                                <font><Font size="14.0" /></font>
                            </Label>
                            <TextField fx:id="emailField" prefHeight="45.0" promptText="Entrez votre email" style="-fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14;">
                            </TextField>
                        </VBox>

                        <!-- CHANGER MOT DE PASSE (OPTIONNEL) -->
                        <Label text="🔒 Changer le mot de passe (optionnel)" textFill="#666666">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>

                        <HBox spacing="20.0">
                            <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="Ancien mot de passe" textFill="#666666">
                                        <font><Font size="14.0" /></font>
                                    </Label>
                                    <PasswordField fx:id="ancienMdpField" prefHeight="45.0" promptText="••••••••" style="-fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14;" />
                                </VBox>

                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="Nouveau mot de passe" textFill="#666666">
                                        <font><Font size="14.0" /></font>
                                    </Label>
                                    <PasswordField fx:id="nouveauMdpField" prefHeight="45.0" promptText="••••••••" style="-fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14;" />
                                </VBox>

                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="Confirmer le mot de passe" textFill="#666666">
                                        <font><Font size="14.0" /></font>
                                    </Label>
                                    <PasswordField fx:id="confirmMdpField" prefHeight="45.0" promptText="••••••••" style="-fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14;" />
                                </VBox>
                            </children>
                        </HBox>

                        <!-- BOUTONS -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <Button onAction="#handleEnregistrer" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;" text="💾 Enregistrer les modifications">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>

                                <Button onAction="#handleAnnuler" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;" text="✖️ Annuler">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
