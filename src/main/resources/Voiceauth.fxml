<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<!--
    Widget d'authentification vocale
    À inclure dans la page de login
-->
<VBox spacing="12.0"
      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.VoiceAuthController">

    <!-- Titre -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <children>
            <Label text="🎤" style="-fx-font-size: 20px;"/>
            <VBox spacing="2.0">
                <children>
                    <Label text="Authentification Vocale"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2e4d2e;"/>
                    <Label text="Parlez pour vous identifier"
                           style="-fx-font-size: 10px; -fx-text-fill: #aaa;"/>
                </children>
            </VBox>
        </children>
    </HBox>

    <!-- Séparateur -->
    <HBox prefHeight="1.0" style="-fx-background-color: #f0f0f0;"/>

    <!-- Indicateur micro + boutons -->
    <HBox alignment="CENTER" spacing="15.0">
        <children>

            <!-- Bouton Enregistrer -->
            <Button fx:id="btnRecord"
                    onAction="#handleRecord"
                    prefHeight="42.0" prefWidth="140.0"
                    text="🔴 Enregistrer"
                    style="-fx-background-color: #f5f5f5; -fx-text-fill: #333; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-border-width: 1.5;"/>

            <!-- Bouton Vérifier -->
            <Button fx:id="btnVerify"
                    onAction="#handleVerify"
                    prefHeight="42.0" prefWidth="140.0"
                    text="✅ Vérifier"
                    disable="true"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 12px; -fx-font-weight: bold;"/>

        </children>
    </HBox>

    <!-- Barre de progression -->
    <ProgressBar fx:id="progressBar"
                 prefWidth="300.0" prefHeight="6.0"
                 style="-fx-accent: #4CAF50;"
                 visible="false"/>

    <!-- Status -->
    <Label fx:id="statusLabel"
           text="🎤 Prêt — Cliquez sur Enregistrer"
           style="-fx-font-size: 12px; -fx-text-fill: #666;"
           wrapText="true"/>

    <!-- Résultat -->
    <VBox fx:id="resultBox" spacing="6.0" visible="false">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  style="-fx-background-color: #f5f8f5; -fx-background-radius: 10; -fx-padding: 10;">
                <children>
                    <Label text="Résultat :"
                           style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                    <Label fx:id="similarityLabel"
                           text="—"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
                </children>
            </HBox>
        </children>
    </VBox>

    <!-- Bouton inscription première fois -->
    <Button fx:id="btnEnroll"
            onAction="#handleEnroll"
            prefWidth="300.0" prefHeight="34.0"
            text="📝 Première fois ? Enregistrer mon empreinte vocale"
            style="-fx-background-color: transparent; -fx-text-fill: #4CAF50; -fx-font-size: 11px; -fx-cursor: hand; -fx-border-color: #4CAF5040; -fx-border-radius: 8; -fx-border-width: 1;"/>

</VBox>
