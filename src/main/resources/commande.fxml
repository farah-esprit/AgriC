<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900" prefWidth="1600" style="-fx-background-color: #f5f5dc;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CommandeController">

    <!-- HEADER -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #5a8c4a, #4a7c3a);">
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20 30; -fx-background-color: #f0f4f0;">
                <Region prefWidth="20" />
                <VBox spacing="2">
                    <Label style="-fx-text-fill: black; -fx-font-size: 26px; -fx-font-weight: bold;" text="AgriConnect - Gestion des Commandes" />
                    <Label style="-fx-text-fill: black; -fx-font-size: 13px;" text="Créez, suivez et mettez à jour les commandes" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />

                <!-- Stats header -->
                <HBox spacing="8">
                    <VBox alignment="CENTER" prefWidth="90" style="-fx-background-color: #388e3c #388e3c; -fx-background-radius: 10; -fx-padding: 7 12;">
                        <Label style="-fx-text-fill: #e8f5e9; -fx-font-size: 9px; -fx-letter-spacing: 1px;" text="TOTAL" />
                        <Label fx:id="lblTotal" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="90" style="-fx-background-color: #388e3c; -fx-background-radius: 10; -fx-padding: 7 12;">
                        <Label style="-fx-text-fill: #e8f5e9; -fx-font-size: 9px; -fx-letter-spacing: 1px;" text="EN COURS" />
                        <Label fx:id="lblEnCours" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="90" style="-fx-background-color: #388e3c; -fx-background-radius: 10; -fx-padding: 7 12;">
                        <Label style="-fx-text-fill: #e8f5e9; -fx-font-size: 9px; -fx-letter-spacing: 1px;" text="ANNULÉES" />
                        <Label fx:id="lblAnnulees" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
                    </VBox>
                </HBox>

                <Label fx:id="lblStatus" style="-fx-text-fill: white; -fx-font-size: 13px;                               -fx-background-color: rgba(0,0,0,0.2); -fx-padding: 8 15; -fx-background-radius: 15;" text="Prêt" />
            </HBox>
        </VBox>
    </top>

    <!-- MAIN -->
    <center>
        <SplitPane dividerPositions="0.28" style="-fx-background-color: #f5f5dc;">

            <!-- LEFT - FORMULAIRE -->
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED">
                <VBox spacing="15" style="-fx-padding: 25; -fx-background-color: #f0f4f0 #f0f4f0;">

                    <HBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4a7c3a;" text="📝 Nouvelle / Modifier" />
                    </HBox>

                    <VBox spacing="18" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                        <VBox spacing="5">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a7c3a;" text="Produit" />
                            <ComboBox fx:id="cbProduit" maxWidth="Infinity" prefHeight="40" promptText="Sélectionnez un produit..." style="-fx-background-color: #f9f9f9; -fx-border-color: #4a7c3a;                                              -fx-border-radius: 5; -fx-background-radius: 5;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a7c3a;" text="Quantité" />
                            <TextField fx:id="tfQuantite" prefHeight="40" promptText="Ex: 50" style="-fx-background-color: #f9f9f9; -fx-border-color: #4a7c3a;                                               -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-size: 13px;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a7c3a;" text="Statut" />
                            <ComboBox fx:id="cbStatut" maxWidth="Infinity" prefHeight="40" promptText="Sélectionnez le statut..." style="-fx-background-color: #f9f9f9; -fx-border-color: #4a7c3a;                                              -fx-border-radius: 5; -fx-background-radius: 5;" />
                        </VBox>

                        <Separator style="-fx-background-color: #e0e0e0;" />

                        <Button maxWidth="Infinity" onAction="#handleAjouter" prefHeight="44" style="-fx-background-color: #5a8c4a; -fx-text-fill: white; -fx-font-size: 13px;                                        -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="➕ Ajouter" />
                        <Button maxWidth="Infinity" onAction="#handleModifier" prefHeight="40" style="-fx-background-color: #f0ad4e; -fx-text-fill: white; -fx-font-size: 13px;                                        -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="✏️ Modifier Statut" />
                        <Button maxWidth="Infinity" onAction="#handleSupprimer" prefHeight="40" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-size: 13px;                                        -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="🗑️ Supprimer" />

                        <Separator style="-fx-background-color: #e0e0e0;" />

                        <HBox spacing="8">
                            <Button maxWidth="Infinity" onAction="#handleActualiser" prefHeight="38" style="-fx-background-color: #5bc0de; -fx-text-fill: white; -fx-font-size: 11px;                                            -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="🔄 Actualiser" HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity" onAction="#handlePayerStripe" prefHeight="38" style="-fx-background-color: #5a8c4a; -fx-text-fill: white; -fx-font-size: 11px;                                            -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="💳 Stripe" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <Button maxWidth="Infinity" onAction="#exporterCSV" prefHeight="38" style="-fx-background-color: #5bc0de; -fx-text-fill: white; -fx-font-size: 12px;                                        -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="📤 Exporter CSV" />
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- RIGHT - KANBAN -->
            <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" style="-fx-background-color: #f0f4e8; -fx-background: #f0f4e8; -fx-border-color: transparent;" vbarPolicy="NEVER" HBox.hgrow="ALWAYS">
                <HBox spacing="12" style="-fx-padding: 20; -fx-background-color: #f0f4f0;">

                    <!-- Colonne EN_COURS -->
                    <VBox prefWidth="240" style="-fx-background-color: white; -fx-background-radius: 12;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 14 16; -fx-background-color: #5bc0de;                                      -fx-background-radius: 12 12 0 0;">
                            <Label style="-fx-font-size: 14px;" text="⏳" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-letter-spacing: 1px;" text="EN COURS" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="badgeEnCours" style="-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white;                                           -fx-font-size: 11px; -fx-font-weight: bold;                                           -fx-padding: 2 8; -fx-background-radius: 10;" text="0" />
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                            <VBox fx:id="colEnCours" spacing="8" style="-fx-padding: 10; -fx-background-color: transparent;" />
                        </ScrollPane>
                    </VBox>

                    <!-- Colonne VALIDEE -->
                    <VBox prefWidth="240" style="-fx-background-color: white; -fx-background-radius: 12;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 14 16; -fx-background-color: #5a8c4a;                                      -fx-background-radius: 12 12 0 0;">
                            <Label style="-fx-font-size: 14px;" text="✅" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-letter-spacing: 1px;" text="VALIDÉE" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="badgeValidee" style="-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white;                                           -fx-font-size: 11px; -fx-font-weight: bold;                                           -fx-padding: 2 8; -fx-background-radius: 10;" text="0" />
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                            <VBox fx:id="colValidee" spacing="8" style="-fx-padding: 10; -fx-background-color: transparent;" />
                        </ScrollPane>
                    </VBox>

                    <!-- Colonne EXPEDIEE -->
                    <VBox prefWidth="240" style="-fx-background-color: white; -fx-background-radius: 12;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 14 16; -fx-background-color: #7b68ee;                                      -fx-background-radius: 12 12 0 0;">
                            <Label style="-fx-font-size: 14px;" text="🚚" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-letter-spacing: 1px;" text="EXPÉDIÉE" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="badgeExpediee" style="-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white;                                           -fx-font-size: 11px; -fx-font-weight: bold;                                           -fx-padding: 2 8; -fx-background-radius: 10;" text="0" />
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                            <VBox fx:id="colExpediee" spacing="8" style="-fx-padding: 10; -fx-background-color: transparent;" />
                        </ScrollPane>
                    </VBox>

                    <!-- Colonne LIVREE -->
                    <VBox prefWidth="240" style="-fx-background-color: white; -fx-background-radius: 12;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 14 16; -fx-background-color: #f0ad4e;                                      -fx-background-radius: 12 12 0 0;">
                            <Label style="-fx-font-size: 14px;" text="📦" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-letter-spacing: 1px;" text="LIVRÉE" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="badgeLivree" style="-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white;                                           -fx-font-size: 11px; -fx-font-weight: bold;                                           -fx-padding: 2 8; -fx-background-radius: 10;" text="0" />
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                            <VBox fx:id="colLivree" spacing="8" style="-fx-padding: 10; -fx-background-color: transparent;" />
                        </ScrollPane>
                    </VBox>

                    <!-- Colonne ANNULEE -->
                    <VBox prefWidth="240" style="-fx-background-color: white; -fx-background-radius: 12;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 14 16; -fx-background-color: #d9534f;                                      -fx-background-radius: 12 12 0 0;">
                            <Label style="-fx-font-size: 14px;" text="❌" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-letter-spacing: 1px;" text="ANNULÉE" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="badgeAnnulee" style="-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white;                                           -fx-font-size: 11px; -fx-font-weight: bold;                                           -fx-padding: 2 8; -fx-background-radius: 10;" text="0" />
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                            <VBox fx:id="colAnnulee" spacing="8" style="-fx-padding: 10; -fx-background-color: transparent;" />
                        </ScrollPane>
                    </VBox>

                </HBox>
            </ScrollPane>
        </SplitPane>
    </center>

</BorderPane>
