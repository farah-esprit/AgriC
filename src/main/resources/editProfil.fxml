<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EditProfilController">
    <children>
        <VBox maxWidth="480.0" prefHeight="512.0" prefWidth="480.0" spacing="15.0" style="-fx-background-color: #e7e3e3;" StackPane.alignment="CENTER">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
            <children>
                <Label fx:id="titleLabel" text="Modifier mon profil" textFill="#395936">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
                <Label fx:id="messageLabel" prefHeight="20.0">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Circle fx:id="profileCircle" fill="#dcdcdc" radius="60.0" stroke="#395936" strokeWidth="3.0" />
                        <Button fx:id="uploadButton" onAction="#handleUploadImage" style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-cursor: hand;" text="📷 Choisir photo">
                            <font><Font size="12.0" /></font>
                        </Button>
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Nom *"><font><Font name="System Bold" size="13.0" /></font></Label>
                        <TextField fx:id="nomField" prefHeight="35.0" promptText="Votre nom" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Prénom *">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="prenomField" prefHeight="35.0" promptText="Votre nom" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;" />
                            </children>
                        </VBox>
                        <Label text="Téléphone *"><font><Font name="System Bold" size="13.0" /></font></Label>
                        <TextField fx:id="telephoneField" prefHeight="35.0" promptText="+216 XX XXX XXX" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Biographie"><font><Font name="System Bold" size="13.0" /></font></Label>
                        <TextArea fx:id="bioField" prefHeight="80.0" promptText="Parlez-nous de vous..." style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;" wrapText="true" />
                    </children>
                </VBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button fx:id="saveButton" onAction="#handleSaveProfil" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="Enregistrer">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                        <Button onAction="#handleCancel" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #cccccc; -fx-text-fill: #333; -fx-cursor: hand; -fx-background-radius: 5;" text="Annuler">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>