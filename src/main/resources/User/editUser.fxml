<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EditUserController">
    <children>
        <VBox maxWidth="450.0" spacing="15.0" StackPane.alignment="CENTER">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
            <children>
                <Label text="Modifier l'utilisateur" textFill="#1a237e">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
                <VBox spacing="5.0" />
                <VBox spacing="5.0">
                    <children>
                        <Label text="Nom *"><font><Font name="System Bold" size="13.0" /></font></Label>
                        <TextField fx:id="nomField" prefHeight="35.0" promptText="Nom complet" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Email *"><font><Font name="System Bold" size="13.0" /></font></Label>
                        <TextField fx:id="emailField" prefHeight="35.0" promptText="email@exemple.com" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Mot de passe *"><font><Font name="System Bold" size="13.0" /></font></Label>
                        <PasswordField fx:id="passwordField" prefHeight="35.0" promptText="Mot de passe" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Rôle *"><font><Font name="System Bold" size="13.0" /></font></Label>
                        <ComboBox fx:id="roleComboBox" prefHeight="35.0" prefWidth="390.0" promptText="Choisir un rôle" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="État du compte *"><font><Font name="System Bold" size="13.0" /></font></Label>
                        <ComboBox fx:id="etatComboBox" prefHeight="35.0" prefWidth="390.0" promptText="Choisir l'état" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button onAction="#handleSave" prefHeight="45.0" prefWidth="300.0" style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="Enregistrer les modifications">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                        <Button onAction="#handleCancel" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: #cccccc; -fx-text-fill: #333; -fx-cursor: hand; -fx-background-radius: 5;" text=" Annuler">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>