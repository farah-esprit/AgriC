<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.VerificationController">

    <!-- ==================== CÔTÉ GAUCHE FIXE (VERT) ==================== -->
    <StackPane style="-fx-background-color: #e7e3e3;" HBox.hgrow="ALWAYS" />

    <!-- ==================== CÔTÉ DROIT DYNAMIQUE (BLANC) ==================== -->
    <StackPane style="-fx-background-color: white;" HBox.hgrow="ALWAYS">
        <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0">
            <padding>
                <Insets bottom="40.0" left="30.0" right="30.0" top="40.0" />
            </padding>

            <!-- Icône -->
            <Label alignment="CENTER" text="🔐">
                <font><Font size="80.0" /></font>
            </Label>

            <!-- Titre -->
            <Label alignment="CENTER" text="Activation du compte">
                <font><Font name="System Bold" size="28.0" /></font>
            </Label>

            <!-- Sous-titre -->
            <Label alignment="CENTER" text="Entrez le code reçu par email" textFill="#666666" wrapText="true">
                <font><Font size="14.0" /></font>
            </Label>

            <!-- Champ code -->
            <VBox spacing="6.0">
                <Label text="Code de vérification" textFill="#333333">
                    <font><Font size="14.0" /></font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #28a745; -fx-border-width: 0 0 2 0; -fx-padding: 8;">
                    <Label text="🔢">
                        <font><Font size="18.0" /></font>
                    </Label>
                    <TextField fx:id="codeField" promptText="Entrez le code à 6 chiffres" style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS">
                        <font><Font size="14.0" /></font>
                    </TextField>
                </HBox>
            </VBox>

            <!-- Bouton Vérifier -->
            <Button onAction="#handleVerify" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: #28a745; -fx-background-radius: 25; -fx-cursor: hand;" text="Vérifier" textFill="WHITE">
                <font><Font name="System Bold" size="16.0" /></font>
            </Button>

            <!-- Label message -->
            <Label fx:id="messageLabel" alignment="CENTER" prefWidth="350.0" textAlignment="CENTER" wrapText="true">
                <font><Font size="12.0" /></font>
            </Label>

            <!-- Lien retour -->
            <HBox alignment="CENTER" spacing="5.0">
                <Label text="Code non reçu ?" textFill="#666666">
                    <font><Font size="13.0" /></font>
                </Label>
                <Hyperlink onAction="#handleBackToLogin" text="Retour au login" textFill="#28a745">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Hyperlink>
            </HBox>
        </VBox>
    </StackPane>

</HBox>