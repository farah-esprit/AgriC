
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
    <!-- CÔTÉ GAUCHE (image) -->
    <StackPane style="-fx-background-color: #e7e3e3;" HBox.hgrow="ALWAYS">
        <VBox alignment="CENTER" prefHeight="818.0" prefWidth="189.0" spacing="30.0">
            <ImageView fitHeight="320.0" fitWidth="238.0" preserveRatio="true">
                <image><Image url="@images/logo.png" /></image>
            </ImageView>
            <Label alignment="CENTER" text="Connecter. Cultiver. Réussir.">
                <font><Font name="System Bold" size="15.0" /></font>
            </Label>
        </VBox>
    </StackPane>

    <!-- CÔTÉ DROIT (scrollable) -->
    <StackPane fx:id="contentPane" style="-fx-background-color: white;" HBox.hgrow="ALWAYS">

        <!-- ✅ AJOUT ScrollPane pour rendre scrollable -->
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: white; -fx-background: white;" vbarPolicy="AS_NEEDED">

            <content>
                <VBox alignment="TOP_CENTER" style="-fx-background-color: white;">

                    <!-- FORMULAIRE LOGIN -->
                    <VBox fx:id="loginFormBox" alignment="CENTER" maxWidth="370.0" spacing="16.0">
                        <padding><Insets bottom="30.0" left="20.0" right="20.0" top="30.0" /></padding>

                        <Label alignment="CENTER" text="Sign In">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>

                        <!-- ══════════════════════════════════════════════════════ -->
                        <!-- CONNEXION VOCALE 100%                                 -->
                        <!-- ══════════════════════════════════════════════════════ -->
                        <VBox prefHeight="186.0" prefWidth="330.0" spacing="12.0" style="-fx-background-color: linear-gradient(to right, #f5f0e8,   #28a745); -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(102, 126, 234, 0.4), 15, 0, 0, 5);">

                            <!-- Titre -->
                            <HBox alignment="CENTER" spacing="10.0">
                                <Label style="-fx-font-size: 30px;" text="🎤" />
                                <VBox spacing="2.0">
                                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="Connexion Vocale" />
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.9);" text="Parlez pour vous identifier automatiquement" wrapText="true" />
                                </VBox>
                            </HBox>

                            <!-- Barre de progression -->
                            <ProgressBar fx:id="voiceProgressBar" prefHeight="6.0" prefWidth="330.0" progress="0" style="-fx-accent: #4CAF50;" visible="false" />

                            <!-- Status -->
                            <Label fx:id="voiceStatusLabel" alignment="CENTER" style="-fx-font-size: 12px; -fx-text-fill: white; -fx-font-weight: bold;" text="Cliquez et parlez pour vous connecter" wrapText="true" />

                            <!-- Bouton unique : Connexion vocale -->
                            <Button fx:id="btnVoiceLogin" onAction="#handleVoiceLogin" prefHeight="50.0" prefWidth="310.0" style="-fx-background-color: white;                                        -fx-text-fill: #667eea;                                        -fx-background-radius: 25;                                        -fx-cursor: hand;                                        -fx-font-size: 14px;                                        -fx-font-weight: bold;                                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);" text="🎤  PARLER POUR SE CONNECTER" />

                            <!-- Résultat -->
                            <Label fx:id="voiceSimilarityLabel" alignment="CENTER" style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: bold;" text="" visible="false" />
                        </VBox>
                        <!-- ══════════════ FIN CONNEXION VOCALE ══════════════ -->

                        <!-- Séparateur -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <VBox.margin><Insets bottom="10.0" top="10.0" /></VBox.margin>
                            <Label text="━━━━━━" textFill="#cccccc"><font><Font size="14.0" /></font></Label>
                            <Label text="ou connexion classique" textFill="#666666"><font><Font size="12.0" /></font></Label>
                            <Label text="━━━━━━" textFill="#cccccc"><font><Font size="14.0" /></font></Label>
                        </HBox>

                        <!-- Email -->
                        <VBox spacing="6.0">
                            <Label text="Email" textFill="#333333"><font><Font size="14.0" /></font></Label>
                            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #28a745; -fx-border-width: 0 0 2 0; -fx-padding: 8;">
                                <Label text="📧"><font><Font size="18.0" /></font></Label>
                                <TextField fx:id="emailField" promptText="Entrez votre email" style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS"><font><Font size="14.0" /></font></TextField>
                            </HBox>
                        </VBox>

                        <!-- Mot de passe -->
                        <VBox spacing="6.0">
                            <Label text="Mot de passe" textFill="#333333"><font><Font size="14.0" /></font></Label>
                            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #28a745; -fx-border-width: 0 0 2 0; -fx-padding: 8;">
                                <Label text="🔒"><font><Font size="18.0" /></font></Label>
                                <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe" style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS"><font><Font size="14.0" /></font></PasswordField>
                            </HBox>
                        </VBox>

                        <!-- Mot de passe oublié -->
                        <Button onAction="#handleForgotPassword" style="-fx-background-color: transparent; -fx-text-fill: #388e3c; -fx-cursor: hand; -fx-underline: true;" text="Mot de passe oublié ?"><font><Font size="13.0" /></font></Button>

                        <!-- Bouton Login classique -->
                        <Button fx:id="loginButton" onAction="#handleLogin" prefHeight="30.0" prefWidth="194.0" style="-fx-background-color: #28a745; -fx-background-radius: 25; -fx-cursor: hand;" text="Login" textFill="WHITE">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Button>

                        <!-- Google -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <VBox.margin><Insets top="5.0" /></VBox.margin>
                            <Label text="━━━" textFill="#cccccc"><font><Font size="14.0" /></font></Label>
                            <Label text="ou" textFill="#666666"><font><Font size="13.0" /></font></Label>
                            <Label text="━━━" textFill="#cccccc"><font><Font size="14.0" /></font></Label>
                        </HBox>

                        <Button onAction="#handleGoogleLogin" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: white; -fx-border-color: #dddddd;                                    -fx-border-width: 2; -fx-border-radius: 25;                                    -fx-background-radius: 25; -fx-cursor: hand;">
                            <graphic>
                                <HBox alignment="CENTER" spacing="10.0">
                                    <Label text="🌐"><font><Font size="20.0" /></font></Label>
                                    <Label text="Se connecter avec Google" textFill="#333333">
                                        <font><Font name="System Bold" size="13.0" /></font>
                                    </Label>
                                </HBox>
                            </graphic>
                        </Button>

                        <Label fx:id="errorLabel" alignment="CENTER" prefWidth="330.0" textAlignment="CENTER" textFill="RED" wrapText="true">
                            <font><Font size="12.0" /></font>
                        </Label>

                        <HBox alignment="CENTER" spacing="5.0">
                            <Label text="Vous n'avez pas de compte ?" textFill="#666666">
                                <font><Font size="13.0" /></font>
                            </Label>
                            <Hyperlink onAction="#handleRegister" style="-fx-underline: true;" text="Créer un compte" textFill="#28a745">
                                <font><Font size="13.0" /></font>
                            </Hyperlink>
                        </HBox>
                    </VBox>

                    <!-- ══════════════════════════════════════════════ -->
                    <!-- FORMULAIRE SÉLECTION RÔLE GOOGLE (caché)     -->
                    <!-- ══════════════════════════════════════════════ -->
                    <VBox fx:id="googleRoleBox" alignment="CENTER" managed="false" maxWidth="380.0" spacing="20.0" visible="false">
                        <padding><Insets bottom="40.0" left="30.0" right="30.0" top="40.0" /></padding>

                        <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@images/logo.png" /></image>
                        </ImageView>

                        <Label alignment="CENTER" text="Choisissez votre rôle">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>

                        <Label alignment="CENTER" text="Dernière étape pour finaliser votre inscription" textAlignment="CENTER" textFill="#666666" wrapText="true">
                            <font><Font size="14.0" /></font>
                        </Label>

                        <VBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #f0f9ff; -fx-background-radius: 12; -fx-padding: 15;">
                            <HBox alignment="CENTER" spacing="10.0">
                                <Label text="👤" textFill="#2196f3"><font><Font size="25.0" /></font></Label>
                                <VBox alignment="CENTER_LEFT">
                                    <Label fx:id="googleNameLabel" text="Nom" textFill="#1e293b">
                                        <font><Font name="System Bold" size="16.0" /></font>
                                    </Label>
                                    <Label fx:id="googleEmailLabel" text="email@example.com" textFill="#64748b">
                                        <font><Font size="12.0" /></font>
                                    </Label>
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox spacing="8.0">
                            <Label text="Type de compte" textFill="#333333"><font><Font size="14.0" /></font></Label>
                            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #28a745; -fx-border-width: 0 0 2 0; -fx-padding: 8;">
                                <Label text="🎭"><font><Font size="20.0" /></font></Label>
                                <ChoiceBox fx:id="googleRoleChoice" prefWidth="320.0" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                            </HBox>
                        </VBox>

                        <Button onAction="#handleGoogleRoleContinue" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #28a745; -fx-background-radius: 25; -fx-cursor: hand;" text="Continuer" textFill="WHITE">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Button>

                        <Label fx:id="googleErrorLabel" alignment="CENTER" prefWidth="350.0" textAlignment="CENTER" wrapText="true">
                            <font><Font size="12.0" /></font>
                        </Label>

                        <Button onAction="#handleBackToLoginForm" style="-fx-background-color: transparent; -fx-text-fill: #999999;                                    -fx-cursor: hand; -fx-underline: true;" text="← Retour à la connexion">
                            <font><Font size="12.0" /></font>
                        </Button>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>

    </StackPane>
</HBox>