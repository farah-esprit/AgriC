<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RegisterController">
    <children>

        <!-- ✅ CÔTÉ DROIT - FORMULAIRE (60% de l'écran) -->
        <StackPane prefWidth="730.0" style="-fx-background-color: white;" HBox.hgrow="ALWAYS">
            <children>
                <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: white; -fx-background-color: white;" vbarPolicy="AS_NEEDED">
                    <content>
                        <!-- ✅ Formulaire centré avec largeur fixe -->
                        <VBox alignment="TOP_CENTER" spacing="8.0">
                            <padding>
                                <Insets bottom="30.0" left="60.0" right="60.0" top="30.0" />
                            </padding>
                            <children>
                                <Label text="Sign Up" >
                                    <font>
                                        <Font name="System Bold" size="28.0" />
                                    </font>
                                </Label>

                                <!-- Nom -->
                                <VBox maxWidth="420.0" prefWidth="420.0" spacing="5.0">
                                    <Label text="Nom complet" textFill="#333333">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #28a745; -fx-border-width: 0 0 2 0; -fx-padding: 8;">
                                        <Label text="✍">
                                            <font>
                                                <Font size="20.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="nomField" promptText="Entrez votre nom" style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </TextField>
                                    </HBox>
                                </VBox>

                                <!-- Email -->
                                <VBox maxWidth="420.0" prefWidth="420.0" spacing="5.0">
                                    <Label text="Email" textFill="#333333">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #28a745; -fx-border-width: 0 0 2 0; -fx-padding: 8;">
                                        <Label text="📧">
                                            <font>
                                                <Font size="20.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="emailField" promptText="Entrez votre email" style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </TextField>
                                    </HBox>
                                </VBox>

                                <!-- Mot de passe -->
                                <VBox maxWidth="420.0" prefWidth="420.0" spacing="5.0">
                                    <Label text="Mot de passe" textFill="#333333">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #28a745; -fx-border-width: 0 0 2 0; -fx-padding: 8;">
                                        <Label text="🔒">
                                            <font>
                                                <Font size="18.0" />
                                            </font>
                                        </Label>
                                        <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe" style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </PasswordField>
                                        <TextField fx:id="passwordTextField" managed="false" promptText="Entrez votre mot de passe" style="-fx-background-color: transparent; -fx-border-width: 0;" visible="false" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </TextField>
                                        <Button fx:id="togglePasswordBtn" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-border-width: 0;" text="👁">
                                            <font>
                                                <Font size="18.0" />
                                            </font>
                                        </Button>
                                    </HBox>
                                    <Label fx:id="passwordStrengthLabel" text="" visible="false">
                                        <font>
                                            <Font size="11.0" />
                                        </font>
                                    </Label>
                                </VBox>

                                <!-- Confirmer mot de passe -->
                                <VBox maxWidth="420.0" prefWidth="420.0" spacing="5.0">
                                    <Label text="Confirmer mot de passe" textFill="#333333">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #28a745; -fx-border-width: 0 0 2 0; -fx-padding: 8;">
                                        <Label text="🔒">
                                            <font>
                                                <Font size="18.0" />
                                            </font>
                                        </Label>
                                        <PasswordField fx:id="confirmPasswordField" promptText="Confirmez votre mot de passe" style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </PasswordField>
                                        <TextField fx:id="confirmPasswordTextField" managed="false" promptText="Confirmez votre mot de passe" style="-fx-background-color: transparent; -fx-border-width: 0;" visible="false" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </TextField>
                                        <Button fx:id="toggleConfirmPasswordBtn" onAction="#toggleConfirmPasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-border-width: 0;" text="👁">
                                            <font>
                                                <Font size="18.0" />
                                            </font>
                                        </Button>
                                    </HBox>
                                </VBox>

                                <!-- Type de compte -->
                                <VBox maxWidth="420.0" prefWidth="420.0" spacing="5.0">
                                    <Label text="Type de compte" textFill="#333333">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <ChoiceBox fx:id="roleChoice" prefWidth="420.0" style="-fx-font-size: 14px;" />
                                </VBox>

                                <!-- CAPTCHA -->
                                <VBox maxWidth="420.0" prefWidth="420.0" spacing="5.0">
                                    <VBox.margin>
                                        <Insets top="5.0" />
                                    </VBox.margin>
                                    <Label text="🔒 Vérification de sécurité" textFill="#333333">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                    </Label>
                                    <AnchorPane fx:id="captchaContainer" minHeight="80.0" prefHeight="100.0" prefWidth="420.0" style="-fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-color: #f9f9f9; -fx-background-radius: 5;" />
                                    <Label fx:id="captchaStatusLabel" text="">
                                        <font>
                                            <Font size="12.0" />
                                        </font>
                                    </Label>
                                </VBox>

                                <!-- EMPREINTE VOCALE -->
                                <VBox fx:id="voiceEnrollBox" maxWidth="420.0" prefWidth="420.0" spacing="8.0" style="-fx-background-color: #f0f9f0; -fx-background-radius: 12; -fx-border-color: #4CAF5055; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 12;">
                                    <VBox.margin>
                                        <Insets top="4.0" />
                                    </VBox.margin>

                                    <!-- Titre -->
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <Label style="-fx-font-size: 18px;" text="🎙️" />
                                        <VBox spacing="2.0">
                                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2e4d2e;" text="Empreinte Vocale (optionnel)" />
                                            <Label style="-fx-font-size: 10px; -fx-text-fill: #888;" text="Enregistrez 3 échantillons pour sécuriser votre connexion" wrapText="true" />
                                        </VBox>
                                    </HBox>

                                    <!-- Compteur échantillons -->
                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #666;" text="Échantillons :" />
                                        <Label fx:id="enrollStepLabel" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" text="0 / 3" />
                                    </HBox>

                                    <!-- Barre progression -->
                                    <ProgressBar fx:id="enrollProgressBar" prefHeight="5.0" prefWidth="395.0" progress="0" style="-fx-accent: #4CAF50;" visible="false" />

                                    <!-- Status -->
                                    <Label fx:id="enrollStatusLabel" style="-fx-font-size: 11px; -fx-text-fill: #666;" text="Cliquez Enregistrer et parlez 3 secondes" wrapText="true" />

                                    <!-- Boutons -->
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Button fx:id="btnEnrollRecord" onAction="#handleEnrollRecord" prefHeight="34.0" prefWidth="195.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 11px; -fx-border-width: 1.5;" text="🔴  Enregistrer (3s)" />
                                        <Button fx:id="btnEnrollSave" disable="true" onAction="#handleEnrollSave" prefHeight="34.0" prefWidth="195.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 11px; -fx-font-weight: bold;" text="💾  Valider" />
                                    </HBox>

                                    <!-- Badge succès -->
                                    <Label fx:id="enrollDoneLabel" style="-fx-font-size: 12px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" text="✅ Empreinte vocale enregistrée !" visible="false" />
                                </VBox>

                                <!-- SIGN UP -->
                                <Button fx:id="registerButton" onAction="#handleRegister" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #28a745; -fx-background-radius: 25; -fx-cursor: hand;" text="SIGN UP" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets top="10.0" />
                                    </VBox.margin>
                                </Button>

                                <Label fx:id="errorLabel" alignment="CENTER" prefWidth="420.0" textAlignment="CENTER" wrapText="true">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>

                                <HBox alignment="CENTER" spacing="5.0">
                                    <Label text="Vous avez déjà un compte ?" textFill="#666666">
                                        <font>
                                            <Font size="13.0" />
                                        </font>
                                    </Label>
                                    <Hyperlink onAction="#handleBackToLogin" style="-fx-underline: true;" text="Se connecter" textFill="#28a745">
                                        <font>
                                            <Font name="System Bold" size="13.0" />
                                        </font>
                                    </Hyperlink>
                                </HBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </StackPane>

    </children>
</HBox>