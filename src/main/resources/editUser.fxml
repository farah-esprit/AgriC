<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="450.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EditUserController">
    <children>
        <VBox layoutX="30.0" layoutY="30.0" prefHeight="490.0" prefWidth="390.0" spacing="15.0">
            <children>
                <!-- TITRE -->
                <Label text="✏️ Modifier l'utilisateur" textFill="#1a237e">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <!-- MESSAGE D'ERREUR/SUCCÈS -->
                <Label fx:id="messageLabel" prefHeight="25.0" textFill="RED">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>

                <!-- ID UTILISATEUR (lecture seule) -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="ID Utilisateur">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="idField" editable="false" prefHeight="35.0" style="-fx-background-color: #f0f0f0; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </TextField>
                    </children>
                </VBox>

                <!-- NOM -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="Nom *">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="nomField" prefHeight="35.0" promptText="Nom complet" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </TextField>
                    </children>
                </VBox>

                <!-- EMAIL -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="Email *">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="emailField" prefHeight="35.0" promptText="email@exemple.com" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </TextField>
                    </children>
                </VBox>

                <!-- MOT DE PASSE -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="Mot de passe *">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <PasswordField fx:id="passwordField" prefHeight="35.0" promptText="Mot de passe" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </PasswordField>
                    </children>
                </VBox>

                <!-- RÔLE -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="Rôle *">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="roleComboBox" prefHeight="35.0" prefWidth="390.0" promptText="Choisir un rôle" />
                    </children>
                </VBox>

                <!-- ÉTAT DU COMPTE -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="État du compte *">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="etatComboBox" prefHeight="35.0" prefWidth="390.0" promptText="Choisir l'état" />
                    </children>
                </VBox>

                <!-- BOUTONS D'ACTION -->
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button onAction="#handleSave" prefHeight="45.0" prefWidth="300.0" style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="💾 Enregistrer les modifications">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button onAction="#handleCancel" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: #cccccc; -fx-text-fill: #333; -fx-cursor: hand; -fx-background-radius: 5;" text="❌ Annuler">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>