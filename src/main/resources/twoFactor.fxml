<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TwoFactorController">
    <children>
        <!-- Bouton retour en haut à gauche -->
        <Button layoutX="20.0" layoutY="20.0" onAction="#handleBack" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="← Retour" StackPane.alignment="TOP_LEFT">
            <font><Font size="12.0" /></font>
            <StackPane.margin><Insets left="20.0" top="20.0" /></StackPane.margin>
        </Button>

        <VBox alignment="TOP_CENTER" maxWidth="860.0" prefHeight="834.0" prefWidth="780.0" spacing="30.0" style="-fx-background-color: #e7e3e3; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" StackPane.alignment="CENTER">
            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
            <children>
                <Label text="🔐 Authentification à Deux Facteurs (2FA)" textFill="#388e3c">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
                <Label text="Sécurisez votre compte avec la double authentification" textFill="#666666">
                    <font><Font size="14.0" /></font>
                </Label>
                <VBox prefHeight="82.0" prefWidth="700.0" spacing="20.0" style="-fx-background-color: #e7e3e3; -fx-background-radius: 10; -fx-padding: 20;">
                    <children>
                        <Label text="📋 Comment activer le 2FA :" textFill="#388e3c">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <HBox spacing="10.0">
                            <children>
                                <Label style="-fx-font-size: 18;" text="1️" />
                                <Label text="Téléchargez Google Authenticator ou Microsoft Authenticator sur votre téléphone" textFill="#333333" wrapText="true">
                                    <font><Font size="13.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label style="-fx-font-size: 18;" text="2️" />
                                <Label text="Scannez le QR code ci-dessous avec l'application" textFill="#333333" wrapText="true">
                                    <font><Font size="13.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label style="-fx-font-size: 18;" text="3️" />
                                <Label text="Entrez le code à 6 chiffres généré par l'application" textFill="#333333" wrapText="true">
                                    <font><Font size="13.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                      <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #f9f9f9; -fx-background-radius: 10; -fx-padding: 20;">
                          <children>
                              <Label text="Scannez ce QR Code" textFill="#666666">
                                  <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                              </Label>
                              <ImageView fx:id="qrCodeImage" fitHeight="154.0" fitWidth="200.0" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" />
                              <Label fx:id="secretLabel" style="-fx-font-family: monospace;" text="" textFill="#999999">
                                  <font>
                              <Font size="11.0" />
                           </font>
                              </Label>
                          </children>
                      </VBox>
                      <VBox alignment="CENTER" spacing="15.0">
                          <children>
                              <Label text="Entrez le code à 6 chiffres :" textFill="#666666">
                                  <font>
                              <Font size="14.0" />
                           </font>
                              </Label>
                              <TextField fx:id="codeField" alignment="CENTER" maxWidth="200.0" prefHeight="50.0" promptText="000000" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-border-color: #388e3c; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8;" />
                          </children>
                      </VBox>
                      <HBox alignment="CENTER" spacing="20.0">
                          <children>
                              <Button fx:id="verifyButton" onAction="#handleVerifyCode" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;" text="✓ Vérifier et Activer">
                                  <font>
                              <Font size="14.0" />
                           </font>
                              </Button>
                              <Button onAction="#handleCancel" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;" text="✕ Annuler">
                                  <font>
                              <Font size="14.0" />
                           </font>
                              </Button>
                          </children>
                      </HBox>
                      <Label fx:id="messageLabel" alignment="CENTER" prefWidth="700.0" textAlignment="CENTER">
                          <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                      </Label>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
