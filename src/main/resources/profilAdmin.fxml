<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProfilAdminController">
    <children>
        <!-- SIDEBAR -->
        <AnchorPane prefHeight="700.0" prefWidth="220.0" style="-fx-background-color: #395936;">
            <children>
                <Label contentDisplay="CENTER" layoutX="14.0" layoutY="14.0" text="🌱AgriConnect" textFill="#f2f2f2">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
                <Label layoutX="29.0" layoutY="48.0" text="Administrateur" textFill="#f8f8f8">
                    <font><Font name="System Bold" size="15.0" /></font>
                </Label>
                <Line endX="105.0" layoutX="115.0" layoutY="90.0" startX="-115.0" stroke="#666666" strokeWidth="2.0" />

                <VBox layoutX="10.0" layoutY="110.0" prefHeight="300.0" prefWidth="220.0" spacing="5.0">
                    <children>
                        <HBox onMouseClicked="#handleBackToDashboard" prefHeight="40.0" prefWidth="200.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 5;">
                            <children>
                                <Label text="📊" textFill="WHITE"><font><Font size="20.0" /></font></Label>
                                <Label text="Tableau de bord" textFill="#ffffff"><font><Font size="14.0" /></font></Label>
                            </children>
                            <padding><Insets left="10.0" /></padding>
                        </HBox>

                        <HBox prefHeight="40.0" prefWidth="200.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 5;">
                            <children>
                                <Label text="👤" textFill="WHITE"><font><Font size="20.0" /></font></Label>
                                <Label text="Mon profil" textFill="#ffffff"><font><Font name="System Bold" size="14.0" /></font></Label>
                            </children>
                            <padding><Insets left="10.0" /></padding>
                        </HBox>
                    </children>
                </VBox>

                <Line endX="105.0" layoutX="115.0" layoutY="652.0" startX="-115.0" stroke="#666666" strokeWidth="2.0" />
                <HBox layoutX="10.0" layoutY="660.0" onMouseClicked="#handleLogout" prefHeight="40.0" prefWidth="200.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 5;">
                    <children>
                        <Label text="➜]" textFill="WHITE"><font><Font size="18.0" /></font></Label>
                        <Label text="Déconnexion" textFill="#ffffff"><font><Font size="14.0" /></font></Label>
                    </children>
                    <padding><Insets left="10.0" /></padding>
                </HBox>
            </children>
        </AnchorPane>

        <!-- CONTENU PRINCIPAL -->
        <AnchorPane layoutX="220.0" prefHeight="700.0" prefWidth="980.0" style="-fx-background-color: #f5f5f5;">
            <children>
                <Label layoutX="30.0" layoutY="30.0" text="👤 Mon Profil" textFill="#1a237e">
                    <font><Font name="System Bold" size="32.0" /></font>
                </Label>

                <Label fx:id="messageLabel" layoutX="30.0" layoutY="85.0" prefHeight="25.0" prefWidth="900.0">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>

                <!-- INFORMATIONS -->
                <VBox layoutX="30.0" layoutY="130.0" prefHeight="200.0" prefWidth="920.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <children>
                        <Label text="📋 Informations générales" textFill="#1a237e">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <HBox spacing="30.0">
                            <children>
                                <VBox spacing="5.0">
                                    <Label text="Nom complet :" textFill="#666"><font><Font size="13.0" /></font></Label>
                                    <Label fx:id="nomLabel" text="Admin Principal" textFill="#1a237e">
                                        <font><Font name="System Bold" size="16.0" /></font>
                                    </Label>
                                </VBox>
                                <VBox spacing="5.0">
                                    <Label text="Email :" textFill="#666"><font><Font size="13.0" /></font></Label>
                                    <Label fx:id="emailLabel" text="admin@test.com" textFill="#1a237e">
                                        <font><Font name="System Bold" size="16.0" /></font>
                                    </Label>
                                </VBox>
                                <VBox spacing="5.0">
                                    <Label text="Rôle :" textFill="#666"><font><Font size="13.0" /></font></Label>
                                    <Label fx:id="roleLabel" text="ADMIN" textFill="#1a237e">
                                        <font><Font name="System Bold" size="16.0" /></font>
                                    </Label>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                </VBox>

                <!-- MODIFIER PROFIL -->
                <VBox layoutX="30.0" layoutY="360.0" prefHeight="150.0" prefWidth="450.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <children>
                        <Label text="✏️ Modifier le profil" textFill="#1a237e">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <TextField fx:id="nomField" promptText="Nom complet" style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-background-radius: 5;" />
                        <TextField fx:id="emailField" promptText="Email" style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-background-radius: 5;" />
                        <Button onAction="#handleUpdateProfil" prefHeight="35.0" prefWidth="200.0" style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="💾 Enregistrer">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>

                <!-- CHANGER MOT DE PASSE -->
                <VBox layoutX="500.0" layoutY="360.0" prefHeight="200.0" prefWidth="450.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <children>
                        <Label text="🔒 Changer le mot de passe" textFill="#1a237e">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <PasswordField fx:id="ancienMdpField" promptText="Ancien mot de passe" style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-background-radius: 5;" />
                        <PasswordField fx:id="nouveauMdpField" promptText="Nouveau mot de passe" style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-background-radius: 5;" />
                        <PasswordField fx:id="confirmMdpField" promptText="Confirmer le mot de passe" style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-background-radius: 5;" />
                        <Button onAction="#handleChangePassword" prefHeight="35.0" prefWidth="250.0" style="-fx-background-color: #ff5722; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="🔑 Changer le mot de passe">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>