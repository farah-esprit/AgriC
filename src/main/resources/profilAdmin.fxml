<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProfilAdminController">
    <children>
        <!-- SIDEBAR -->
        <AnchorPane fx:id="sidebar" prefWidth="274.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" style="-fx-background-color: #388e3c;">
            <children>
                <!-- HEADER -->
                <Label contentDisplay="CENTER" layoutX="14.0" layoutY="14.0" text="🌱AgriConnect" textFill="#f2f2f2">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label layoutX="29.0" layoutY="48.0" text="Administrateur">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Label>
                <Line endX="116.00003051757812" layoutX="122.0" layoutY="91.0" startX="-122.00000762939453" stroke="#666666" strokeWidth="2.0" />

                <!-- MENU NAVIGATION -->
                <VBox layoutX="10.0" layoutY="110.0" prefHeight="350.0" prefWidth="230.0" spacing="5.0">
                    <children>
                        <!-- Tableau de bord -->
                        <HBox onMouseClicked="#handleBackToDashboard" prefHeight="45.0" prefWidth="220.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 8;">
                            <children>
                                <Label text="📊" textFill="WHITE">
                                    <font>
                                        <Font size="22.0" />
                                    </font>
                                </Label>
                                <Label prefHeight="31.0" prefWidth="109.0" text="Tableau de bord" textFill="WHITE">
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                </Label>
                            </children>
                            <padding>
                                <Insets left="12.0" />
                            </padding>
                        </HBox>

                        <!-- Utilisateurs -->
                        <HBox onMouseClicked="#openManageUsers" prefHeight="45.0" prefWidth="220.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 8;">
                            <children>
                                <Label text="👥" textFill="WHITE">
                                    <font>
                                        <Font size="22.0" />
                                    </font>
                                </Label>
                                <Label prefHeight="38.0" prefWidth="74.0" text="Utilisateurs" textFill="WHITE">
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                </Label>
                            </children>
                            <padding>
                                <Insets left="12.0" />
                            </padding>
                        </HBox>
                    </children>
                </VBox>

                <!-- LIGNE SÉPARATION BAS -->
                <Line endX="113.80001831054688" layoutX="125.0" layoutY="530.0" startX="-125.00000762939453" stroke="#666666" strokeWidth="2.0" />

                <!-- ZONE INFÉRIEURE : DARK MODE + PROFIL + DÉCONNEXION -->
                <VBox alignment="CENTER" layoutX="10.0" layoutY="545.0" prefHeight="145.0" prefWidth="230.0" spacing="8.0">
                    <children>
                        <!-- DARK/LIGHT MODE TOGGLE -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label fx:id="themeModeIcon" text="☀" textFill="WHITE">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                                <ToggleButton fx:id="themeToggle" onAction="#handleToggleTheme" prefHeight="30.0" prefWidth="60.0" style="-fx-background-color: #81c784; -fx-background-radius: 15; -fx-cursor: hand;" text="🌙">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </ToggleButton>
                                <Label fx:id="themeModeText" text="Clair" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- BOUTON PROFIL -->
                        <Button prefHeight="40.0" prefWidth="210.0" style="-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: white; -fx-border-width: 1; -fx-border-radius: 8;" text="👤 Mon Profil">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>

                        <!-- BOUTON DÉCONNEXION -->
                        <Button onMouseClicked="#handleLogout" prefHeight="40.0" prefWidth="210.0" style="-fx-background-color: #000000; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="🚪 Déconnexion">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
        <!-- CONTENU PRINCIPAL -->
        <AnchorPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="274.0" AnchorPane.rightAnchor="0.0" style="-fx-background-color: #f5f5f5;">
            <children>
                <Label layoutX="30.0" layoutY="30.0" text="👤 Mon Profil" textFill="#1a237e">
                    <font><Font name="System Bold" size="32.0" /></font>
                </Label>

                <Label fx:id="messageLabel" layoutX="30.0" layoutY="85.0" prefHeight="25.0" prefWidth="900.0">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>

                <!-- CARTE PROFIL -->
                <VBox layoutX="30.0" layoutY="130.0" prefHeight="400.0" prefWidth="920.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <children>
                        <Label text="📋 Informations générales" textFill="#1a237e">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>

                        <!-- INFORMATIONS AFFICHÉES -->
                        <GridPane hgap="40.0" vgap="20.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="250.0" prefWidth="250.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="250.0" prefWidth="250.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="250.0" prefWidth="250.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="60.0" prefHeight="60.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="60.0" prefHeight="60.0" vgrow="SOMETIMES" />
                            </rowConstraints>

                            <!-- NOM -->
                            <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Nom complet" textFill="#666666">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="nomLabel" text="Admin Principal" textFill="#1a237e">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                            </VBox>

                            <!-- EMAIL -->
                            <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Adresse email" textFill="#666666">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="emailLabel" text="admin@test.com" textFill="#1a237e">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                            </VBox>

                            <!-- RÔLE -->
                            <VBox spacing="8.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Rôle" textFill="#666666">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="roleLabel" text="ADMINISTRATEUR" textFill="#1a237e">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                            </VBox>

                            <!-- ÉTAT DU COMPTE -->
                            <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="État du compte" textFill="#666666">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="etatLabel" text="ACTIF" textFill="#4caf50">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                            </VBox>

                            <!-- DATE DE CRÉATION -->
                            <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Membre depuis" textFill="#666666">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="dateCreationLabel" text="09 Février 2026" textFill="#1a237e">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                            </VBox>
                        </GridPane>

                        <!-- BOUTONS D'ACTION -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <Button onAction="#handleModifierProfil" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;" text="📝 Modifier le profil">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>

                                <Button onAction="#handleSupprimerCompte" prefHeight="46.0" prefWidth="39.0" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;" text="🗑">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
