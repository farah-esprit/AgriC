<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProfilAdminController">
    <children>
        <!-- SIDEBAR -->
        <AnchorPane prefHeight="700.0" prefWidth="220.0" style="-fx-background-color: #395936;">
            <children>
                <Label contentDisplay="CENTER" layoutX="14.0" layoutY="14.0" text="🌱AgriConnect" textFill="#f2f2f2">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
                <Label layoutX="29.0" layoutY="48.0" text="Administrateur" textFill="#f8f8f8">
                    <font><Font name="System Bold" size="15.0" /></font>
                </Label>
                <Line endX="105.0" layoutX="115.0" layoutY="90.0" startX="-115.0" stroke="#666666" strokeWidth="2.0" />

                <VBox layoutX="10.0" layoutY="110.0" prefHeight="300.0" prefWidth="220.0" spacing="5.0">
                    <children>
                        <HBox onMouseClicked="#handleBackToDashboard" prefHeight="40.0" prefWidth="200.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 5;">
                            <children>
                                <Label text="📊" textFill="WHITE"><font><Font size="20.0" /></font></Label>
                                <Label text="Tableau de bord" textFill="#ffffff"><font><Font size="14.0" /></font></Label>
                            </children>
                            <padding><Insets left="10.0" /></padding>
                        </HBox>
                        <HBox onMouseClicked="#openManageUsers" prefHeight="40.0" prefWidth="200.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 5;">
                            <children>
                                <Label text="👥" textFill="WHITE">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                                <Label prefHeight="31.0" prefWidth="150.0" text="Utilisateurs" textFill="#ffffff">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                            </children>
                            <padding>
                                <Insets left="10.0" />
                            </padding>
                        </HBox>
                        <HBox prefHeight="40.0" prefWidth="200.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 5;">
                            <children>
                                <Label text="👤" textFill="WHITE"><font><Font size="20.0" /></font></Label>
                                <Label text="Mon profil" textFill="#ffffff"><font><Font name="System Bold" size="14.0" /></font></Label>
                            </children>
                            <padding><Insets left="10.0" /></padding>
                        </HBox>

                    </children>
                </VBox>

                <Line endX="105.0" layoutX="115.0" layoutY="652.0" startX="-115.0" stroke="#666666" strokeWidth="2.0" />
                <HBox layoutX="10.0" layoutY="660.0" onMouseClicked="#handleLogout" prefHeight="40.0" prefWidth="200.0" spacing="10.0" style="-fx-cursor: hand; -fx-background-radius: 5;">
                    <children>
                        <Label text="➜]" textFill="WHITE"><font><Font size="18.0" /></font></Label>
                        <Label text="Déconnexion" textFill="#ffffff"><font><Font size="14.0" /></font></Label>
                    </children>
                    <padding><Insets left="10.0" /></padding>
                </HBox>
            </children>
        </AnchorPane>

        <!-- CONTENU PRINCIPAL -->
        <AnchorPane layoutX="220.0" prefHeight="700.0" prefWidth="980.0" style="-fx-background-color: #f5f5f5;">
            <children>
                <Label layoutX="30.0" layoutY="30.0" text="👤 Mon Profil" textFill="#1a237e">
                    <font><Font name="System Bold" size="32.0" /></font>
                </Label>

                <Label fx:id="messageLabel" layoutX="30.0" layoutY="85.0" prefHeight="25.0" prefWidth="900.0">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>

                <!-- CARTE PROFIL -->
                <VBox layoutX="30.0" layoutY="130.0" prefHeight="400.0" prefWidth="920.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <children>
                        <Label text="📋 Informations générales" textFill="#1a237e">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>

                        <!-- INFORMATIONS AFFICHÉES -->
                        <GridPane hgap="40.0" vgap="20.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="250.0" prefWidth="250.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="250.0" prefWidth="250.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="250.0" prefWidth="250.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="60.0" prefHeight="60.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="60.0" prefHeight="60.0" vgrow="SOMETIMES" />
                            </rowConstraints>

                            <!-- NOM -->
                            <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Nom complet" textFill="#666666">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="nomLabel" text="Admin Principal" textFill="#1a237e">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                            </VBox>

                            <!-- EMAIL -->
                            <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Adresse email" textFill="#666666">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="emailLabel" text="admin@test.com" textFill="#1a237e">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                            </VBox>

                            <!-- RÔLE -->
                            <VBox spacing="8.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Rôle" textFill="#666666">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="roleLabel" text="ADMINISTRATEUR" textFill="#1a237e">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                            </VBox>

                            <!-- ÉTAT DU COMPTE -->
                            <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="État du compte" textFill="#666666">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="etatLabel" text="ACTIF" textFill="#4caf50">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                            </VBox>

                            <!-- DATE DE CRÉATION -->
                            <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Membre depuis" textFill="#666666">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label fx:id="dateCreationLabel" text="09 Février 2026" textFill="#1a237e">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                            </VBox>
                        </GridPane>

                        <!-- BOUTONS D'ACTION -->
                        <HBox spacing="20.0" alignment="CENTER_LEFT">
                            <children>
                                <Button onAction="#handleModifierProfil" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;" text="✏️ Modifier le profil">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>

                                <Button onAction="#handleSupprimerCompte" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;" text="🗑️ Supprimer le compte">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>